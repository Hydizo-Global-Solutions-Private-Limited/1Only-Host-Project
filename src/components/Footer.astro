---
interface Props {
  basePrefix?: string;
}
const { basePrefix = './' } = Astro.props;
---
<div class="footer-three dark-version mesh-bg-dark">
  <div class="container lg">
    <div class="address-wrapper">
      <h2>Need Some Help?</h2>
      <div class="row gx-xxl-5">
        <div class="col-lg-4 d-flex">
          <div class="block d-flex w-100 align-items-center mt-25">
            <div class="icon d-flex align-items-center justify-content-center rounded-circle">
              <img src={`${basePrefix}images/mail.svg`} alt="Mail">
            </div>
            <div class="text">
              <div class="title">We're always happy to help</div>
              <span class="fs-20"><a href="mailto:support@1onlyhost.com">support@1onlyhost.com</a></span>
            </div>
          </div>
        </div>
        <div class="col-lg-4 d-flex">
          <div class="block d-flex w-100 align-items-center mt-25">
            <div class="d-flex align-items-center">
              <div class="icon d-flex align-items-center justify-content-center rounded-circle">
                <img src={`${basePrefix}images/phone.svg`} alt="Phone">
              </div>
              <div class="text">
                <div class="title">Our Hotline Number</div>
                <span class="fs-20">+91 895 475 8694</span>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-4 d-flex">
          <div class="block d-flex w-100 align-items-center mt-25">
            <div class="icon d-flex align-items-center justify-content-center rounded-circle">
              <img src={`${basePrefix}images/live-chat.svg`} alt="Live Chat">
            </div>
            <div class="text">
              <div class="title">Live chat</div>
              <span class="fs-20"><a href="mailto:sales@1onlyhost.com">sales@1onlyhost.com</a></span>
            </div>
          </div>
        </div>
      </div>
    </div>
   
    <div class="position-relative">
      <div class="row justify-content-between">
        <div class="col-lg-2 order-lg-0 md-mb-40">
          <div class="logo mt-15">
            <a href="/">
              <img src={`${basePrefix}images/logo.svg`} alt="1Only Host">
            </a>
          </div>
          <div class="fs-6 mt-40 mb-15">Connect with us</div>
          <ul class="style-none d-flex align-items-center social-icon">
            <li><a href="#"><i class="fi fi-brands-facebook"></i></a></li>
            <li><a href="#"><i class="fi fi-brands-twitter-alt"></i></a></li>
            <li><a href="#"><i class="fi fi-brands-instagram"></i></a></li>
          </ul>
        </div>
        
        <div class="col-lg-2 col-6">
          <div class="footer-nav">
            <ul class="footer-nav-link style-none">
              <li><a href="/shared-hosting">Shared Hosting</a></li>
              <li><a href="/wordpress-hosting">WordPress Hosting</a></li>
              <li><a href="/reseller-hosting">Reseller Hosting</a></li>
              <li><a href="/cloud-hosting">Cloud Hosting</a></li>
              <li><a href="/dedicated-server">Dedicated Server</a></li>
              <li><a href="/vps-server">VPS Server</a></li>
            </ul>
          </div>
        </div>
        
        <div class="col-lg-2 col-6">
          <div class="footer-nav">
            <ul class="footer-nav-link style-none">
              <li><a href="/bussiness-email">Business Email</a></li>
              <li><a href="/titan-business-email">Titan Business Email</a></li>
              <li><a href="/enterprises-email">Enterprises Email</a></li>
              <li><a href="/google-workspace">Google Workspace</a></li>
            </ul>
          </div>
        </div>
        
        <div class="col-lg-2 col-6">
          <div class="footer-nav mb-20">
            <ul class="footer-nav-link style-none">
              <li><a href="/ssl-certificate">SSL Certificate</a></li>
              <li><a href="/sitelock-malware">Sitelock Malware</a></li>
              <li><a href="/codeguard-backup">CodeGuard Backup</a></li>
              <li><a href="/acronis-cyber-backup">Acronis Cyber Backup</a></li>
            </ul>
          </div>
        </div>
        
        <div class="col-lg-2 col-6">
          <div class="footer-nav mb-20">
            <ul class="footer-nav-link style-none">
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/legal-agreement">Legal Agreement</a></li>
              <li><a href="/about-us">About Us</a></li>
              <li><a href="/contact">Contact Us</a></li>
              <li><a href="#">Knowledgebase</a></li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="row justify-content-between">
        <div class="col-lg-12">
          <p class="copyright-text text-center mt-30">
            <span class="fw-500">Copyright © 2026 1Only Host.</span> All Rights Reserved
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<button class="scroll-top"><i class="icon icon-arrow-up"></i></button>
