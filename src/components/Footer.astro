---
interface Props {
  basePrefix?: string;
}
const { basePrefix = './' } = Astro.props;
---
<style>
  /* Footer Redesign */
  .footer-premium-glass {
    position: relative;
    background: #02040A;
    border-top: 1px solid rgba(255, 158, 0, 0.1);
    overflow: hidden;
  }
  
  .footer-premium-glass::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 158, 0, 0.5), transparent);
  }

  .footer-glass-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 24px;
    transition: all 0.3s ease;
    height: 100%;
  }

  .footer-glass-card:hover {
    background: rgba(255, 158, 0, 0.04);
    border-color: rgba(255, 158, 0, 0.2);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(255, 158, 0, 0.05);
  }

  .footer-icon-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 158, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FF9E00;
    font-size: 20px;
    transition: all 0.3s ease;
  }

  .footer-glass-card:hover .footer-icon-circle {
    background: #FF9E00;
    color: #fff;
    box-shadow: 0 0 20px rgba(255, 158, 0, 0.4);
  }

  .footer-nav-title {
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 10px;
  }

  .footer-nav-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: linear-gradient(90deg, #FF9E00, #FF007F);
    border-radius: 2px;
  }

  .footer-link-modern {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
    padding: 4px 0;
    font-size: 15px;
  }

  .footer-link-modern:hover {
    color: #FF9E00;
    transform: translateX(5px);
  }

  .social-icon-modern {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-icon-modern:hover {
    background: linear-gradient(135deg, #FF9E00, #FF007F);
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(255, 0, 127, 0.3);
  }
</style>

<div class="footer-premium-glass pt-80 pb-30">
  <div class="container lg">
    <!-- Help Section Cards -->
    <div class="row g-4 mb-80">
      <div class="col-lg-4">
        <div class="footer-glass-card d-flex align-items-center">
          <div class="footer-icon-circle me-3">
            <i class="icon icon-email"></i>
          </div>
          <div>
            <div class="text-white-50 fs-13 uppercase tracking-widest mb-1">Email Support</div>
            <a href="mailto:support@1onlyhost.com" class="text-white fs-18 fw-600 text-decoration-none hover-accent">support@1onlyhost.com</a>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="footer-glass-card d-flex align-items-center">
          <div class="footer-icon-circle me-3">
            <i class="icon icon-phone"></i>
          </div>
          <div>
            <div class="text-white-50 fs-13 uppercase tracking-widest mb-1">24/7 Hotline</div>
            <span class="text-white fs-18 fw-600">+91 895 475 8694</span>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="footer-glass-card d-flex align-items-center">
          <div class="footer-icon-circle me-3">
            <i class="icon icon-chat"></i>
          </div>
          <div>
            <div class="text-white-50 fs-13 uppercase tracking-widest mb-1">Sales Inquiry</div>
            <a href="mailto:sales@1onlyhost.com" class="text-white fs-18 fw-600 text-decoration-none hover-accent">sales@1onlyhost.com</a>
          </div>
        </div>
      </div>
    </div>
   
    <div class="row justify-content-between mb-50">
      <div class="col-lg-3 col-md-6 mb-40 md-mb-40">
        <div class="logo mb-4">
          <a href="/">
            <img src={`${basePrefix}images/logo.svg`} alt="1Only Host" style="height: 45px;">
          </a>
        </div>
        <p class="text-white-50 fs-15 leading-relaxed mb-4" style="max-width: 280px;">
          Empowering businesses with blazing-fast, secure, and reliable web hosting solutions across the globe. Built on our robust Heliocentric Cloud infrastructure.
        </p>
        <div class="d-flex align-items-center gap-2">
          <a href="#" class="social-icon-modern"><i class="fi fi-brands-facebook"></i></a>
          <a href="#" class="social-icon-modern"><i class="fi fi-brands-twitter-alt"></i></a>
          <a href="#" class="social-icon-modern"><i class="fi fi-brands-instagram"></i></a>
          <a href="#" class="social-icon-modern"><i class="fi fi-brands-linkedin"></i></a>
        </div>
      </div>
      
      <div class="col-lg-2 col-6 mb-40">
        <h5 class="footer-nav-title">Hosting</h5>
        <ul class="style-none ps-0">
          <li><a href="/shared-hosting" class="footer-link-modern">Shared Hosting</a></li>
          <li><a href="/wordpress-hosting" class="footer-link-modern">WordPress Hosting</a></li>
          <li><a href="/reseller-hosting" class="footer-link-modern">Reseller Hosting</a></li>
          <li><a href="/cloud-hosting" class="footer-link-modern">Cloud Hosting</a></li>
          <li><a href="/vps-server" class="footer-link-modern">VPS Server</a></li>
          <li><a href="/dedicated-server" class="footer-link-modern">Dedicated Server</a></li>
        </ul>
      </div>
      
      <div class="col-lg-2 col-6 mb-40">
        <h5 class="footer-nav-title">Business</h5>
        <ul class="style-none ps-0">
          <li><a href="/bussiness-email" class="footer-link-modern">Business Email</a></li>
          <li><a href="/titan-business-email" class="footer-link-modern">Titan Email</a></li>
          <li><a href="/enterprises-email" class="footer-link-modern">Enterprise Email</a></li>
          <li><a href="/google-workspace" class="footer-link-modern">Google Workspace</a></li>
        </ul>
      </div>
      
      <div class="col-lg-2 col-6 mb-40">
        <h5 class="footer-nav-title">Security</h5>
        <ul class="style-none ps-0">
          <li><a href="/ssl-certificate" class="footer-link-modern">SSL Certificate</a></li>
          <li><a href="/sitelock-malware" class="footer-link-modern">Sitelock Malware</a></li>
          <li><a href="/codeguard-backup" class="footer-link-modern">CodeGuard Backup</a></li>
          <li><a href="/acronis-cyber-backup" class="footer-link-modern">Acronis Backup</a></li>
        </ul>
      </div>
      
      <div class="col-lg-2 col-6 mb-40">
        <h5 class="footer-nav-title">Company</h5>
        <ul class="style-none ps-0">
          <li><a href="/about-us" class="footer-link-modern">About Us</a></li>
          <li><a href="/contact" class="footer-link-modern">Contact Us</a></li>
          <li><a href="/privacy-policy" class="footer-link-modern">Privacy Policy</a></li>
          <li><a href="/legal-agreement" class="footer-link-modern">Legal Agreement</a></li>
          <li><a href="#" class="footer-link-modern">Knowledgebase</a></li>
        </ul>
      </div>
    </div>
    
    <div class="border-top border-light border-opacity-10 pt-4 mt-2">
      <div class="row align-items-center">
        <div class="col-md-6 text-center text-md-start">
          <p class="text-white-50 fs-14 m-0">
            Copyright © {new Date().getFullYear()} <span class="text-white fw-600">1Only Host</span>. All Rights Reserved.
          </p>
        </div>
        <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
          <img src={`${basePrefix}images/cards.png`} alt="Payment Methods" class="img-fluid" style="height: 24px; opacity: 0.7; filter: grayscale(100%); transition: filter 0.3s;" onmouseover="this.style.filter='grayscale(0%)'" onmouseout="this.style.filter='grayscale(100%)'">
        </div>
      </div>
    </div>
  </div>
</div>

<button class="scroll-top"><i class="icon icon-arrow-up"></i></button>
