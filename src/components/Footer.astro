---
interface Props {
  basePrefix?: string;
}
const { basePrefix = './' } = Astro.props;
---
<style>
  /* Footer Redesign */
  .footer-premium-glass {
    position: relative;
    background: #02040A;
    border-top: 1px solid rgba(255, 158, 0, 0.1);
    overflow: hidden;
  }
  
  .footer-premium-glass::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 158, 0, 0.5), transparent);
  }

  .footer-glass-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 24px;
    transition: all 0.3s ease;
    height: 100%;
  }

  .footer-glass-card:hover {
    background: rgba(255, 158, 0, 0.04);
    border-color: rgba(255, 158, 0, 0.2);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(255, 158, 0, 0.05);
  }

  .footer-icon-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 158, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FF9E00;
    font-size: 20px;
    transition: all 0.3s ease;
  }

  .footer-glass-card:hover .footer-icon-circle {
    background: #FF9E00;
    color: #fff;
    box-shadow: 0 0 20px rgba(255, 158, 0, 0.4);
  }

  .footer-nav-title {
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 10px;
  }

  .footer-nav-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: linear-gradient(90deg, #FF9E00, #FF007F);
    border-radius: 2px;
  }

  .footer-link-modern {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
    padding: 4px 0;
    font-size: 15px;
  }

  .footer-link-modern:hover {
    color: #FF9E00;
    transform: translateX(5px);
  }

  .social-icon-modern {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-icon-modern:hover {
    background: linear-gradient(135deg, #FF9E00, #FF007F);
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(255, 0, 127, 0.3);
  }
</style>

<div class="footer-premium-glass pt-80 pb-30">
  <div class="container lg">
    <!-- Help Section Cards -->
    <div class="row g-4 mb-60 justify-content-center">
      <div class="col-lg-10">
        <div class="footer-glass-card d-flex flex-column flex-lg-row align-items-center justify-content-between p-4" style="background: rgba(10, 15, 30, 0.6); border: 1px solid rgba(255, 158, 0, 0.2);">
          <div class="mb-4 mb-lg-0 text-center text-lg-start">
            <h4 class="text-white mb-2 font-outfit">Questions? We’re here to help!</h4>
            <p class="text-white-50 m-0">Available 24/7 , 7 days a week, 30 days a month.</p>
          </div>
          <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="mailto:support@1onlyhost.com" class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2" style="background: linear-gradient(135deg, #FF9E00, #FF007F); border: none; border-radius: 8px; color: #fff; font-weight: 600;">
              <i class="fi fi-rr-envelope"></i> Send Mail
            </a>
            <a href="/contact" class="btn btn-outline-light d-flex align-items-center gap-2 px-4 py-2" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; color: #fff;">
              <i class="fi fi-rr-book-alt"></i> Knowledge Base
            </a>
            <a href="/contact" class="btn btn-outline-light d-flex align-items-center gap-2 px-4 py-2" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; color: #fff;">
              <i class="fi fi-rr-play-alt"></i> Video Guides
            </a>
            <a href="/contact" class="btn btn-outline-light d-flex align-items-center gap-2 px-4 py-2" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; color: #fff;">
              <i class="fi fi-rr-headset"></i> Submit Ticket
            </a>
          </div>
        </div>
      </div>
    </div>
   
    <div class="row justify-content-between mb-50">
      <div class="col-lg-3 col-md-6 mb-40 md-mb-40">
        <div class="logo mb-4">
          <a href="/">
            <img src={`${basePrefix}images/logo.svg`} alt="1Only Host" style="height: 45px;">
          </a>
        </div>
        <p class="text-white-50 fs-15 leading-relaxed mb-4" style="max-width: 280px;">
          Empowering businesses with blazing-fast, secure, and reliable web hosting solutions across the globe. Built on our robust Heliocentric Cloud infrastructure.
        </p>
        <div class="d-flex align-items-center gap-2">
          <a href="#" class="social-icon-modern" aria-label="Facebook"><i class="fi fi-brands-facebook"></i></a>
          <a href="#" class="social-icon-modern" aria-label="Instagram"><i class="fi fi-brands-instagram"></i></a>
          <a href="#" class="social-icon-modern" aria-label="YouTube"><i class="fi fi-brands-youtube"></i></a>
          <a href="#" class="social-icon-modern" aria-label="LinkedIn"><i class="fi fi-brands-linkedin"></i></a>
        </div>
      </div>
      
      <div class="col-lg-2 col-6 mb-40">
        <h5 class="footer-nav-title">Domain and Hosting</h5>
        <ul class="style-none ps-0">
          <li><a href="/shared-hosting" class="footer-link-modern">Shared Hosting</a></li>
          <li><a href="/reseller-hosting" class="footer-link-modern">Reseller hosting</a></li>
          <li><a href="/student-hosting" class="footer-link-modern">Student hosting</a></li>
          <li><a href="/domain-registration" class="footer-link-modern">Domain registration</a></li>
          <li><a href="/domain-transfer" class="footer-link-modern">Domain transfer</a></li>
        </ul>
      </div>
      
      <div class="col-lg-2 col-6 mb-40">
        <h5 class="footer-nav-title">Servers</h5>
        <ul class="style-none ps-0">
          <li><a href="/indian-vps" class="footer-link-modern">Indian VPS</a></li>
          <li><a href="/dedicated-server" class="footer-link-modern">Dedicated server</a></li>
          <li><a href="/cloud-server" class="footer-link-modern">Cloud server</a></li>
          <li><a href="/indian-dedicated-servers" class="footer-link-modern">Indian Dedicated Servers</a></li>
        </ul>
      </div>
      
      <div class="col-lg-2 col-6 mb-40">
        <h5 class="footer-nav-title">Important links</h5>
        <ul class="style-none ps-0">
          <li><a href="/affiliate" class="footer-link-modern">Join as Affiliate</a></li>
          <li><a href="/data-center" class="footer-link-modern">Data Center Locations</a></li>
          <li><a href="/login" class="footer-link-modern">Login</a></li>
          <li><a href="/support" class="footer-link-modern">Create Support Ticket</a></li>
        </ul>
      </div>
      
      <div class="col-lg-2 col-6 mb-40">
        <h5 class="footer-nav-title">Company</h5>
        <ul class="style-none ps-0">
          <li><a href="/about-us" class="footer-link-modern">About</a></li>
          <li><a href="/blogs" class="footer-link-modern">Blogs</a></li>
          <li><a href="/sitemap" class="footer-link-modern">Sitemap</a></li>
          <li><a href="/careers" class="footer-link-modern">Careers</a></li>
          <li><a href="/certification" class="footer-link-modern">Certification</a></li>
          <li><a href="/contact" class="footer-link-modern">Contact us</a></li>
        </ul>
      </div>
    </div>
    
    <div class="border-top border-light border-opacity-10 pt-4 mt-2">
      <!-- Legal Links -->
      <div class="row mb-3">
        <div class="col-12 text-center">
          <div class="d-flex flex-wrap justify-content-center gap-3 gap-md-4">
            <a href="/terms-and-conditions" class="text-white-50 hover-white fs-13 text-decoration-none">Terms and Conditions</a>
            <a href="/privacy-policy" class="text-white-50 hover-white fs-13 text-decoration-none">Privacy Policy</a>
            <a href="/refund-policy" class="text-white-50 hover-white fs-13 text-decoration-none">Refund Policy</a>
            <a href="/service-level-agreement" class="text-white-50 hover-white fs-13 text-decoration-none">Service level agreement</a>
            <a href="/infringement" class="text-white-50 hover-white fs-13 text-decoration-none">Infringement</a>
          </div>
        </div>
      </div>
      
      <div class="row align-items-center">
        <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
          <p class="text-white-50 fs-14 m-0">
            Copyright © {new Date().getFullYear()} <span class="text-white fw-600">1Onlyhost</span>, Child Company of <a href="https://hydizo.com" target="_blank" class="text-white text-decoration-none hover-accent">Hydizo Global Solutions Private Limited and UK Limited.</a>
          </p>
        </div>
        <div class="col-md-6 mt-4 mt-md-0">
          <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-end align-items-center">
            <div class="payment-badge"><img src={`${basePrefix}images/payments/visa.svg`} alt="Visa" style="height: 16px; width: auto; object-fit: contain;"></div>
            <div class="payment-badge"><img src={`${basePrefix}images/payments/mastercard.svg`} alt="Mastercard" style="height: 22px; width: auto; object-fit: contain;"></div>
            <div class="payment-badge"><img src={`${basePrefix}images/payments/paypal.svg`} alt="PayPal" style="height: 18px; width: auto; object-fit: contain;"></div>
            <div class="payment-badge"><img src={`${basePrefix}images/payments/discover.svg`} alt="Discover" style="height: 14px; width: auto; object-fit: contain;"></div>
            <div class="payment-badge"><img src={`${basePrefix}images/payments/upi.svg`} alt="UPI" style="height: 22px; width: auto; object-fit: contain;"></div>
            <div class="payment-badge"><img src={`${basePrefix}images/payments/stripe.svg`} alt="Stripe" style="height: 22px; width: auto; object-fit: contain;"></div>
          </div>
        </div>
      </div>
    </div>
    <style>
      .payment-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        min-width: 52px;
        padding: 0 10px;
        background: #fff;
        border-radius: 6px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .payment-badge:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255,255,255,0.15);
      }
    </style>
  </div>
</div>

<button class="scroll-top"><i class="icon icon-arrow-up"></i></button>
