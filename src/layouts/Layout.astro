---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DataCentersGlobe from '../components/DataCentersGlobe.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const { 
  title = "1Only Host - Reliable Web Hosting & Domain Services Provider", 
  description = "1Only Host offers premium web hosting and domain services, providing fast, secure, and affordable solutions for businesses.", 
  keywords = "web hosting, domain services, reliable hosting, affordable hosting, secure hosting"
} = Astro.props;

// Compute dynamic basePrefix for relative path resolution
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const basePrefix = pathSegments.length > 0 ? '../'.repeat(pathSegments.length) : './';
const isHome = pathSegments.length === 0 || (pathSegments.length === 1 && (pathSegments[0] === 'index.html' || pathSegments[0] === 'index'));
---

<!doctype html>
<html class="no-js" lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <link rel="icon" type="image/png" sizes="56x56" href={`${basePrefix}images/favicon.png`}>
    
    <!-- Stylesheets loaded from public assets -->
    <link rel="stylesheet" type="text/css" href={`${basePrefix}css/bootstrap.min.css`} media="all">
    <link rel="stylesheet" type="text/css" href={`${basePrefix}css/style.min.css`} media="all">
    <link rel="stylesheet" type="text/css" href={`${basePrefix}css/responsive.css`} media="all">
    <link rel="stylesheet" type="text/css" href={`${basePrefix}css/ekiticons.css`} media="all">
    <link rel="stylesheet" type="text/css" href={`${basePrefix}css/design-system.css`} media="all">
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class={isHome ? "is-home-page" : ""}>
    <!-- Floating Space Nebulas Background -->
    <div class="space-nebulas">
      <div class="nebula nebula-amber"></div>
      <div class="nebula nebula-violet"></div>
      <div class="nebula nebula-coral"></div>
    </div>

    <div class="main-page-wrapper">
      <Header basePrefix={basePrefix} isHome={isHome} />
      <slot />
      <DataCentersGlobe />
      <Footer basePrefix={basePrefix} />
    </div>

    <!-- Scripts loaded from public assets -->
    <script is:inline src={`${basePrefix}js/jquery.min.js`}></script>
    <script is:inline src={`${basePrefix}js/bootstrap.bundle.min.js`}></script>
    <script is:inline src={`${basePrefix}js/slick.min.js`}></script>
    <script is:inline src={`${basePrefix}js/jquery.waypoints.min.js`}></script>
    <script is:inline src={`${basePrefix}js/jquery.counterup.min.js`}></script>
    <script is:inline src={`${basePrefix}js/theme.js`}></script>
    
    <!-- AOS Scroll Animations -->
    <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script is:inline>
      AOS.init({
        duration: 800,
        easing: 'ease-out-cubic',
        once: true
      });
    </script>
    
    <!-- Premium Billing/Currency Switcher Handler -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        let currentCurrency = localStorage.getItem('user_currency') || 'USD';
        let currentCycle = localStorage.getItem('user_billing_cycle') || 'monthly';
        
        function updateToggleButtonsUI() {
          document.querySelectorAll('.currency-toggle-pill button').forEach(btn => {
            if (btn.getAttribute('data-currency') === currentCurrency) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          });
          
          document.querySelectorAll('.cycle-toggle-pill button').forEach(btn => {
            if (btn.getAttribute('data-cycle') === currentCycle) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          });
        }
        
        function updateAllPrices() {
          const symbol = currentCurrency === 'USD' ? '$' : '₹';
          
          // Select all pricing elements
          const standardPrices = document.querySelectorAll('[data-usd-monthly]');
          const regularPrices = document.querySelectorAll('[data-reg-usd-monthly]');
          const vpsPriceVal = document.getElementById('price-val');
          const vpsRegPriceDel = document.getElementById('reg-price-del');
          
          // Add updating animation class
          standardPrices.forEach(el => el.classList.add('price-updating'));
          regularPrices.forEach(el => el.classList.add('price-updating'));
          if (vpsPriceVal) vpsPriceVal.classList.add('price-updating');
          if (vpsRegPriceDel) vpsRegPriceDel.classList.add('price-updating');
          
          // Perform state updates and fade-in after a short delay (180ms matches transition)
          setTimeout(() => {
            // 1. Switch active bootstrap tab pane if present
            const monthlyPane = document.getElementById('monthly');
            const yearlyPane = document.getElementById('yearly');
            
            if (monthlyPane && yearlyPane) {
              if (currentCycle === 'monthly') {
                monthlyPane.classList.add('show', 'active');
                yearlyPane.classList.remove('show', 'active');
              } else {
                yearlyPane.classList.add('show', 'active');
                monthlyPane.classList.remove('show', 'active');
              }
            }
            
            // 2. Update standard price values
            standardPrices.forEach(el => {
              const key = `data-${currentCurrency.toLowerCase()}-${currentCycle.toLowerCase()}`;
              const val = el.getAttribute(key);
              if (val !== null) {
                const sub = el.querySelector('sub');
                if (sub) {
                  el.innerHTML = `${symbol}${val}${sub.outerHTML}`;
                } else {
                  el.textContent = `${symbol}${val}`;
                }
              }
            });
            
            // 3. Update regular/strikethrough price values
            regularPrices.forEach(el => {
              const key = `data-reg-${currentCurrency.toLowerCase()}-${currentCycle.toLowerCase()}`;
              const val = el.getAttribute(key);
              if (val !== null) {
                el.textContent = `${symbol}${val}`;
              }
            });
            
            // 4. Dispatch dynamic custom event for reactive Astro components (e.g. VPS Configurator)
            document.dispatchEvent(new CustomEvent('billingChange', {
              detail: { currency: currentCurrency, cycle: currentCycle }
            }));
            
            // Remove updating animation class
            standardPrices.forEach(el => el.classList.remove('price-updating'));
            regularPrices.forEach(el => el.classList.remove('price-updating'));
            if (vpsPriceVal) vpsPriceVal.classList.remove('price-updating');
            if (vpsRegPriceDel) vpsRegPriceDel.classList.remove('price-updating');
          }, 180);
        }
        
        // Delegate click events on switchers
        document.addEventListener('click', (e) => {
          const currencyBtn = e.target.closest('.currency-toggle-pill button');
          const cycleBtn = e.target.closest('.cycle-toggle-pill button');
          
          if (currencyBtn) {
            currentCurrency = currencyBtn.getAttribute('data-currency');
            localStorage.setItem('user_currency', currentCurrency);
            updateToggleButtonsUI();
            updateAllPrices();
          }
          
          if (cycleBtn) {
            currentCycle = cycleBtn.getAttribute('data-cycle');
            localStorage.setItem('user_billing_cycle', currentCycle);
            updateToggleButtonsUI();
            updateAllPrices();
          }
        });
        
        // Initial setup
        updateToggleButtonsUI();
        updateAllPrices();
      });
    </script>
  </body>
</html>
