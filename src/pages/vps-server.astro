---
import Layout from '../layouts/Layout.astro';
import ServerConfigurator from '../components/ServerConfigurator.astro';
import vpsData from '../data/pages/vps-server.json';

export const prerender = true;

const data = vpsData;
---

<Layout 
  title={data.seo.title} 
  description={data.seo.description} 
  keywords={data.seo.keywords}
>
  <!-- Hero Section -->
  <div class="hero-banner-eight bg-twelve z-1 position-relative pt-150 pb-120 mesh-bg-1" data-aos="fade-in">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-xl-10 col-lg-10 col-md-10">
          <h1 class="hero-heading">{data.content.hero_title}</h1>
          <p class="fs-24 font-manrope pt-25 pb-15 pe-xxl-5">{data.content.hero_subtitle}</p>
          <div class="d-inline-block p-3 px-4 rounded-pill fw-600 fs-18" style="background: rgba(255, 158, 0, 0.1); border: 1px solid rgba(255, 158, 0, 0.25); color: var(--accent-color); box-shadow: 0 0 25px rgba(255, 158, 0, 0.15);">
            {data.content.hero_price_label}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- VPS Configurator Section -->
  <div class="my-5">
    <div class="container lg">
      <div class="row justify-content-center text-center">
        <div class="col-12">
          <div class="billing-switcher-container">
            <!-- Currency Toggle -->
            <div class="currency-toggle-pill pill-container">
              <button type="button" class="toggle-btn" data-currency="INR">₹ INR</button>
              <button type="button" class="toggle-btn" data-currency="USD">$ USD</button>
            </div>
            
            <!-- Billing Cycle Toggle -->
            <div class="cycle-toggle-pill pill-container">
              <button type="button" class="toggle-btn" data-cycle="monthly">Monthly</button>
              <button type="button" class="toggle-btn" data-cycle="annually">Annually</button>
              <button type="button" class="toggle-btn" data-cycle="biennially">Biennially</button>
              <button type="button" class="toggle-btn" data-cycle="triennially">Triennially</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <ServerConfigurator />
  </div>

  <!-- Server Hardware Details -->
  <section class="section-gap pt-80 pb-80" data-aos="fade-up">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"><i aria-hidden="true" class="icon icon-flash"></i></div>
              <h4>Full Root <span>Access</span></h4>
            </div>
            <p>Take full control of your server environment with complete SSH root access, allowing you to configure custom web servers, databases, and dependencies.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"><i aria-hidden="true" class="icon icon-support1"></i></div>
              <h4>Guaranteed <span>Resources</span></h4>
            </div>
            <p>We do not oversell. Your VPS instance receives 100% dedicated RAM and KVM-virtualized CPU cores, ensuring stable execution under high traffic.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"><i aria-hidden="true" class="icon icon-server-2"></i></div>
              <h4>DDoS <span>Mitigation</span></h4>
            </div>
            <p>All VPS packages are routed through our multi-layered security shields, filtering out malicious traffic and keeping your instances online.</p>
          </div>
        </div>
      </div>
  </section>

</Layout>
