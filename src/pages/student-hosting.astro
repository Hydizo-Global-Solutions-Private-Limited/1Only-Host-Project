  <!-- ═══════════════════════════════════════════════════ -->
  <!-- ACCORDION FAQ SECTION -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-80 position-relative" style="background: rgba(2, 4, 10, 0.4);">
    <div class="container lg">
      <div class="row text-center mb-50">
        <div class="col-xl-9 col-lg-10 m-auto">
          <div class="d-inline-flex align-items-center mb-3 px-3 py-1 rounded-pill" style="background: rgba(0, 245, 212, 0.1); border: 1px solid rgba(0, 245, 212, 0.2);">
            <span style="background-color: #00F5D4; width: 6px; height: 6px; border-radius: 50%; display: inline-block;" class="me-2"></span>
            <span class="fs-11 text-white-50 uppercase tracking-widest fw-600">Got Questions?</span>
          </div>
          <h2 class="text-white font-outfit fw-900 fs-32 mb-3">Frequently Asked Questions</h2>
          <p class="text-white-50 fs-15 m-0">Find quick answers to common questions about our student hosting plans in India.</p>
        </div>
      </div>
      
      <div class="col-lg-8 mx-auto">
        <div class="accordion accordion-flush" id="faqAccordion">
          
          <!-- Question 1 -->
          <div class="glass-card rounded-4 mb-3 overflow-hidden" style="border-color: rgba(255,255,255,0.06);">
            <h2 class="accordion-header mb-0">
              <button class="accordion-button collapsed bg-transparent text-white font-outfit fw-700 py-3 shadow-none border-0 d-flex justify-content-between align-items-center w-100" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne" style="outline: none; text-align: left;">
                How can 1Only Host offer web hosting at just ₹549/year?
              </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-white-50 fs-14 py-3 px-4" style="border-top: 1px solid rgba(255,255,255,0.05); line-height: 1.7;">
                1Only Host is dedicated to supporting the student community in India. We optimize resource allocation on our cloud servers to offer a highly affordable entry point for undergrads, developers, and students building their first blogs or portfolios.
              </div>
            </div>
          </div>

          <!-- Question 2 -->
          <div class="glass-card rounded-4 mb-3 overflow-hidden" style="border-color: rgba(255,255,255,0.06);">
            <h2 class="accordion-header mb-0">
              <button class="accordion-button collapsed bg-transparent text-white font-outfit fw-700 py-3 shadow-none border-0 d-flex justify-content-between align-items-center w-100" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo" style="outline: none; text-align: left;">
                Can I install WordPress on the Student Hosting Plan?
              </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-white-50 fs-14 py-3 px-4" style="border-top: 1px solid rgba(255,255,255,0.05); line-height: 1.7;">
                Yes! The Student Hosting Plan fully supports WordPress, cPanel, and one-click app installers, allowing you to deploy WordPress, Joomla, or custom Node/HTML sites instantly.
              </div>
            </div>
          </div>

          <!-- Question 3 -->
          <div class="glass-card rounded-4 mb-3 overflow-hidden" style="border-color: rgba(255,255,255,0.06);">
            <h2 class="accordion-header mb-0">
              <button class="accordion-button collapsed bg-transparent text-white font-outfit fw-700 py-3 shadow-none border-0 d-flex justify-content-between align-items-center w-100" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree" style="outline: none; text-align: left;">
                How do I claim my free .site domain name?
