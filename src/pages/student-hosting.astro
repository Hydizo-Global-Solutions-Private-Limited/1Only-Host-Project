---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const title = "Best Student Hosting in India - 1Only Host";
const description = "Affordable, high-performance, and secure web hosting designed specifically for students in India. Build your blog or website with a free domain and SSL.";
const keywords = "student hosting, best student hosting india, cheap student hosting, student web hosting, free domain hosting, 1Only Host student, budget hosting";

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const basePrefix = pathSegments.length > 0 ? '../'.repeat(pathSegments.length) : './';
---

<Layout title={title} description={description} keywords={keywords}>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- HERO SECTION -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="sh-hero position-relative overflow-hidden" data-aos="fade-in">
    <div class="sh-hero-bg position-absolute w-100 h-100 top-0 start-0" style={`background: url('${basePrefix}images/about-hero-datacenter.png') center/cover no-repeat;`}></div>
    <div class="sh-hero-overlay position-absolute w-100 h-100 top-0 start-0"></div>
    
    <div class="container position-relative z-2">
      <div class="row align-items-center sh-hero-inner">
        <div class="col-lg-7 py-5">
          <div class="d-inline-flex align-items-center mb-4 px-3 py-1 rounded-pill" style="background: rgba(131, 56, 236, 0.1); border: 1px solid rgba(131, 56, 236, 0.2);">
            <span style="background-color: #8338EC; width: 8px; height: 8px; border-radius: 50%; display: inline-block; box-shadow: 0 0 6px #8338EC;" class="me-2"></span>
            <span class="fs-12 text-white-50 uppercase tracking-widest fw-600">Empowering the Next Gen Builders</span>
          </div>
          
          <h1 class="text-white fw-900 font-outfit mb-4" style="font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.08;">
            BEST STUDENT <span class="text-gradient">HOSTING</span> IN INDIA
          </h1>
          
          <p class="text-white-50 fs-17 mb-4" style="max-width: 560px; line-height: 1.8;">
            We empower the student community to build their blog or website with top-tier speed, premium support, and rock-solid web security.
          </p>

          <!-- Feature checkmarks in hero -->
          <div class="row g-2 mb-4 fs-14 fw-500 text-white-50 font-outfit" style="max-width: 600px;">
            <div class="col-sm-6 d-flex align-items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF88" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Free Domain</span>
            </div>
            <div class="col-sm-6 d-flex align-items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF88" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Free SSL Certificate</span>
            </div>
            <div class="col-sm-6 d-flex align-items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF88" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
              <span>1GB SSD Disk Space</span>
            </div>
            <div class="col-sm-6 d-flex align-items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF88" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Professional Email Accounts</span>
            </div>
          </div>
          
          <div class="d-flex flex-wrap align-items-center gap-4 mt-4">
            <a href="#plans" class="btn-eighteen py-3 px-5 uppercase tracking-wider fs-13 fw-700">View Plans</a>
            <a href="https://my.1onlyhost.com/register.php" class="btn btn-outline-light py-3 px-5 uppercase tracking-wider fs-13 fw-600 rounded-pill" style="border-color: rgba(255,255,255,0.15);">Buy Now</a>
            <div class="text-white font-outfit fs-14 fw-500">
              <span class="opacity-75">⚡ Lightning Fast Website Loading</span>
            </div>
          </div>
        </div>
        
        <div class="col-lg-5 d-none d-lg-block">
          <div class="glass-card p-2 rounded-4 position-relative overflow-hidden" style="border-color: rgba(131,56,236,0.12) !important;">
            <img src={`${basePrefix}images/student-hosting-hero.png`} alt="best student hosting in india" class="img-fluid rounded-4 w-100" style="height: 380px; object-fit: cover;">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- PRICING SECTION -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-100 position-relative" id="plans" style="background: rgba(2, 4, 10, 0.4);">
    <div class="container lg">
      <div class="row align-items-center justify-content-center">
        <div class="col-lg-6 mb-5 mb-lg-0 text-center text-lg-start pe-lg-5">
          <div class="d-inline-flex align-items-center mb-3 px-3 py-1 rounded-pill" style="background: rgba(0, 245, 212, 0.1); border: 1px solid rgba(0, 245, 212, 0.2);">
            <span style="background-color: #00F5D4; width: 6px; height: 6px; border-radius: 50%; display: inline-block;" class="me-2"></span>
            <span class="fs-11 text-white-50 uppercase tracking-widest fw-600">Unbeatable Price</span>
          </div>
          <h2 class="text-white font-outfit fw-900 fs-38 mb-3">Designed for Students, Priced for Student Budgets.</h2>
          <p class="text-white-50 fs-16 mb-4" style="line-height: 1.8;">
            Get everything you need to start your website. No complex setup, no expensive add-ons. Switch between currencies using the global switcher above.
          </p>
          
          <!-- Currency Indicator Box -->
          <div class="glass-card p-4 rounded-4 text-start mt-4" style="border-left: 3px solid #00F5D4 !important;">
            <div class="billing-switcher-container p-0 border-0 mb-3 justify-content-start d-flex gap-2">
              <span class="text-white-50 fs-14 fw-600 font-outfit me-3 align-self-center">Select currency:</span>
              <div class="currency-toggle-pill pill-container m-0">
                <button type="button" class="toggle-btn" data-currency="INR">₹ INR</button>
                <button type="button" class="toggle-btn" data-currency="USD">$ USD</button>
              </div>
            </div>
            <p class="text-white-50 m-0 fs-13">Changing currency changes the display pricing dynamically across the entire website.</p>
          </div>
        </div>

        <div class="col-lg-5 col-md-8">
          <div class="sh-pricing-card glass-card p-4 rounded-4 position-relative overflow-hidden d-flex flex-column shadow-lg" style="border: 2px solid rgba(0, 245, 212, 0.3) !important;">
            <!-- Popular Ribbon -->
            <div class="position-absolute px-4 py-1 text-white fs-11 fw-700 uppercase tracking-wider" style="background: linear-gradient(135deg, #00F5D4, #8338EC); top: 20px; right: -30px; transform: rotate(45deg); width: 140px; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
              Student Plan
            </div>

            <div class="pr-header text-center mb-3">
              <h4 class="text-white font-outfit fw-800 fs-24 mb-1">Student Hosting Plan</h4>
              <div class="save-line fs-14 text-white-50 fw-600 uppercase tracking-wider mb-3" style="color: #00F5D4 !important;">Best Value for Undergrads & Developers</div>
              
              <!-- Dynamic Price Display -->
              <div class="price text-white font-outfit fw-900 fs-48 my-3" data-usd-annually="6.99" data-inr-annually="549" data-usd-monthly="6.99" data-inr-monthly="549">
                ₹549<sub class="fs-16 opacity-50 fw-400">/Year</sub>
              </div>
            </div>

            <!-- Features list -->
            <ul class="style-none package-feature mb-4 flex-fill ps-0 text-white-50 fs-14">
              <li class="d-flex align-items-center gap-2 mb-2 pb-2" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong>1GB</strong> SSD Disk Space</span>
              </li>
              <li class="d-flex align-items-center gap-2 mb-2 pb-2" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong>5GB</strong> Bandwidth</span>
              </li>
              <li class="d-flex align-items-center gap-2 mb-2 pb-2" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong>Free</strong> .site domain included</span>
              </li>
              <li class="d-flex align-items-center gap-2 mb-2 pb-2" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong>1</strong> Professional Email Account</span>
              </li>
              <li class="d-flex align-items-center gap-2 mb-2 pb-2" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong>Free</strong> SSL Certificate</span>
              </li>
              <li class="d-flex align-items-center gap-2 mb-2 pb-2" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong>Free</strong> Easy Website Builder</span>
              </li>
              <li class="d-flex align-items-center gap-2" style="border-bottom: none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="3" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong>No Contract</strong> or Hidden Fees</span>
              </li>
            </ul>

            <a href="https://my.1onlyhost.com/cart.php?a=add&pid=14" class="btn-eighteen text-center w-100 py-3 rounded-pill uppercase tracking-wider fs-13 fw-700" style="background: linear-gradient(135deg, #00F5D4, #8338EC); border: none; box-shadow: 0 4px 15px rgba(0, 245, 212, 0.3);">
              Buy Now
            </a>

            <!-- Secure Checkout Trust Badges -->
            <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 mt-4 pt-3" style="border-top: 1px solid rgba(255, 255, 255, 0.08);">
              <span class="fs-11 text-white-50 uppercase tracking-widest fw-600 w-100 text-center mb-1">Guaranteed Secure Transactions</span>
              <img src={`${basePrefix}images/razorpay-badge.svg`} alt="Razorpay Secure Checkout" style="height: 20px; opacity: 0.7; filter: brightness(10);" class="img-fluid">
              <img src={`${basePrefix}images/sectigo-badge.svg`} alt="Sectigo SSL Secure" style="height: 24px; opacity: 0.75;" class="img-fluid">
              <img src={`${basePrefix}images/pci-dss-badge.svg`} alt="PCI-DSS Compliant" style="height: 20px; opacity: 0.7;" class="img-fluid">
              <img src={`${basePrefix}images/gdpr-badge.svg`} alt="GDPR Compliant Data Safe" style="height: 22px; opacity: 0.7;" class="img-fluid">
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- COMPARISON TABLE SECTION -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-100 position-relative" data-aos="fade-up" style="border-top: 1px solid rgba(255,255,255,0.04);">
    <div class="container lg">
      <div class="text-center mb-60">
        <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(255, 0, 127, 0.1); color: #FF007F; border: 1px solid rgba(255, 0, 127, 0.2);">Detailed Comparison</span>
        <h2 class="text-white font-outfit fw-900 fs-36">Free vs Paid: Value That Matters</h2>
        <p class="text-white-50 fs-16 mt-2 max-w-700 mx-auto">Compare the Student Hosting Plan against typical free hosts and standard competitor options to see the difference.</p>
      </div>

      <div class="table-responsive glass-card rounded-4 p-4 shadow-lg" style="border-color: rgba(255,255,255,0.06) !important;">
        <table class="table table-borderless align-middle m-0 sh-compare-table">
          <thead>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08) !important;">
              <th scope="col" class="py-4 text-white-50 fw-500 font-outfit fs-15" style="width: 30%;">Features</th>
              <th scope="col" class="py-4 text-center text-white-50 fw-600 font-outfit fs-15 uppercase">Free Web Hosts</th>
              <th scope="col" class="py-4 text-center fw-800 font-outfit fs-15 uppercase sh-popular-col">
                <span class="text-gradient">1Only Student Plan</span>
              </th>
              <th scope="col" class="py-4 text-center text-white-50 fw-600 font-outfit fs-15 uppercase">Competitor Basic</th>
            </tr>
          </thead>
          <tbody>
            <!-- Category: Resource Allocations -->
            <tr>
              <td colspan="4" class="pt-4 pb-2 font-outfit fw-700 text-gradient fs-14 uppercase tracking-widest">Resource Allocations</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">SSD Disk Space</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">500 MB (Slow HDD)</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">1 GB NVMe SSD</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">1 GB (Standard SSD)</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">Bandwidth / Traffic</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">1 GB / Month</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">5 GB Premium</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">2 GB / Month</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">Websites Allowed</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">1 Subdomain only</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">1 Custom Domain</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">1 Custom Domain</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">MySQL Databases</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">1 Database</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">Unlimited Databases</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">1 Database</td>
            </tr>

            <!-- Category: Domain & Branding -->
            <tr>
              <td colspan="4" class="pt-4 pb-2 font-outfit fw-700 text-gradient fs-14 uppercase tracking-widest">Domain & Branding</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">Free Domain Name</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">None</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">Yes (.site/.online)</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">None (Requires purchase)</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">Ad Placement</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14" style="color: #FF007F;">Forced Popup Ads</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">100% Ad-Free</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">Ad-Free</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">Email Accounts</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">None</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">1 cPanel Account</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">None (Paid addon)</td>
            </tr>

            <!-- Category: Security & Control -->
            <tr>
              <td colspan="4" class="pt-4 pb-2 font-outfit fw-700 text-gradient fs-14 uppercase tracking-widest">Security & Control</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">SSL Certificates</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">Self-Signed/None</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">Free Unlimited AutoSSL</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">Additional Charge</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">Control Panel</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">None / Custom Basic</td>
              <td class="py-3 text-center fw-700 text-white font-inter fs-14 sh-popular-col" style="color: #00FF88 !important;">cPanel Control Panel</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">Custom dashboard</td>
            </tr>
            <tr class="sh-compare-row">
              <td class="py-3 fw-500 text-white font-inter fs-14">Uptime SLA</td>
              <td class="py-3 text-center text-white-50 font-inter fs-14">~95.0% (Unreliable)</td>
