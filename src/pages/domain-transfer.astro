                    </div>
                    <a class="link btn-eighteen" href="#">Order Now <i class="icon icon-chevron-right"></i></a>
                </div>
            </div>
        </div>
    </div>
  </section>
  <div class="block-feature-twentyFive mt-0">
  <div class="container lg">
    <div class="  border-2 pt-90 lg-pt-40 pb-90 lg-pb-40">
      <div class="row">
        <div class="col-xl-11 m-auto">
          <div class="title-four text-center mb-80 lg-mb-40 pe-xl-3 ps-xl-3">
            <h2 class="fw-bold">Transferring a domain to Elite is simple.</h2>
          </div>
        </div>
      </div>
      <div class="row gx-xxl-5 gy-4 justify-content-center">
        <div class="col-lg-4 col-md-6">
        <div class="card-style-twelve B text-center mt-20 save-line"> 
          <span class="tag">1</span>
            <h4>Search Your Domain</h4>
               <p>Select a generic domain name suitable for your project.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
        <div class="card-style-twelve B text-center mt-20 save-line">
        <span class="tag">2</span> 
