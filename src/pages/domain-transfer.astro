                        <h4 class="tldprice">$15.65 /mo</h4>
                    </div>
                    <a class="link btn-eighteen" href="#">Order Now <i class="icon icon-chevron-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-12">
                <div class="domain-tld-price">
                    <h3 class="name">.host</h3>
                    
                    <div class="price">
                        <span class="starting">Starting at:</span>
                        <h4 class="tldprice">$14.36 /mo</h4>
                    </div>
                    <a class="link btn-eighteen" href="#">Order Now <i class="icon icon-chevron-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-12">
                <div class="domain-tld-price">
                    <h3 class="name">.online</h3>
                    
                    <div class="price">
                        <span class="starting">Starting at:</span>
                        <h4 class="tldprice">$11.41 /mo</h4>
                    </div>
                    <a class="link btn-eighteen" href="#">Order Now <i class="icon icon-chevron-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-12">
                <div class="domain-tld-price">
