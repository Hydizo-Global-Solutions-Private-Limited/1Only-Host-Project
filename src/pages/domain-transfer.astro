---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const title = "1Only Host - Reliable Web Hosting & Domain Services Provider";
const description = "1Only Host offers premium web hosting and domain services, providing fast, secure, and affordable solutions for businesses and individuals. Get started today!";
const keywords = "web hosting, domain services, reliable hosting, affordable hosting, secure hosting, domain registration, website hosting, cloud hosting, 1Only Host hosting, best web hosting, fast hosting services";
---

<Layout title={title} description={description} keywords={keywords}>
  <div class="hero-banner-eight bg-twelve z-1 position-relative pt-130 pb-160 xl-pb-140 md-p0 mesh-bg-1" data-aos="fade-in">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-10 text-center">
          <h1 class="hero-heading ">Domain Name  <span> Transfer</span> </h1>
          <p class="fs-28  font-manrope pt-25 pb-25 pe-xxl-5">Choose and Transfer from hundreds of different domain extensions at advantageous prices. Take the first step towards creating the website of your dreams!</p>
          <div class="domain-transfer">
            <form action="#" class="m-auto d-flex align-items-center justify-content-between flex-wrap mb-15">
              <input type="name" placeholder="Domain Name.." style="border: 2px solid #FF9E00 !important; color: #ffffff !important; background: rgba(0,0,0,0.2) !important;">
              <select class="select" style="height: 70px; padding: 15px 25px; flex: 1; width: fit-content; min-width: 100px; color: #ffffff !important; outline: unset; max-width: fit-content; border: 2px solid #FF9E00 !important; border-radius: 10px; background: #0a0f1e;">
                <option style="background: #0a0f1e; color: #ffffff;">.com</option>
                <option style="background: #0a0f1e; color: #ffffff;">.net</option>
                <option style="background: #0a0f1e; color: #ffffff;">.info</option>
              </select>
              <button style="background: linear-gradient(135deg, #FF9E00, #FF007F) !important; color: #02040A !important; font-weight: 700; border: none !important;">Search Domain</button>
            </form>
            <ul class="style-none d-flex flex-wrap justify-content-center">
              <li>
                <svg width="20" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 8.28571L7 13L16.8571 1" stroke="#FF9E00" stroke-width="2.5"/>
                </svg>
                No Card required</li>
              <li>
                <svg width="20" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 8.28571L7 13L16.8571 1" stroke="#FF9E00" stroke-width="2.5"/>
                </svg>
                14 Days Free Trial</li>
            </ul>
          </div>
        </div>
          
      </div>
      
    </div>
  </div>
  <section class="">
    <div class="container">
      <div class="row gy-4">
            <div class="col-lg-3 col-md-6 col-12">
                <div class="domain-tld-price">
                    <h3 class="name">.com</h3>
                    <div class="price">
                        <span class="starting">Starting at:</span>
                        <h4 class="tldprice">$12.24 /mo</h4>
                    </div>
                    <a class="link btn-eighteen" href="#">Order Now <i class="icon icon-chevron-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-12">
                <div class="domain-tld-price">
                    <h3 class="name">.net</h3>
                    
                    <div class="price">
                        <span class="starting">Starting at:</span>
