---
import fs from 'fs';
import path from 'path';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const rootDir = process.cwd();
  const files = fs.readdirSync(rootDir);
  const htmlFiles = files.filter(f => f.endsWith('.html'));

  // Exclude files that are handled by dedicated pages or not meant to be static routes
  const exclude = [
    'index.html',
    'about-us.html',
    'contact.html',
    'shared-hosting.html',
    'vps-server.html',
    'login.html',
    'signup.html'
  ];

  const paths = htmlFiles
    .filter(file => !exclude.includes(file))
    .map(file => {
      const slug = file.replace(/\.html$/, '');
      const filePath = path.join(rootDir, file);
      const rawContent = fs.readFileSync(filePath, 'utf8');

      // Extract title, description, keywords
      const titleMatch = rawContent.match(/<title>([^]*?)<\/title>/i);
      const title = titleMatch ? titleMatch[1].trim() : '1Only Host';

      const descMatch = rawContent.match(/<meta\s+name="description"\s+content="([^]*?)"/i) || rawContent.match(/<meta\s+content="([^]*?)"\s+name="description"/i);
      const description = descMatch ? descMatch[1].trim() : '';

      const keyMatch = rawContent.match(/<meta\s+name="keywords"\s+content="([^]*?)"/i) || rawContent.match(/<meta\s+content="([^]*?)"\s+name="keywords"/i);
      const keywords = keyMatch ? keyMatch[1].trim() : '';

      // Extract content inside <div class="main-page-wrapper">
      let bodyContent = '';
      const wrapperStart = rawContent.indexOf('<div class="main-page-wrapper">');
      if (wrapperStart !== -1) {
        bodyContent = rawContent.substring(wrapperStart);
        // Find header-area-end
        const headerEnd = bodyContent.indexOf('<!-- header-area-end -->');
        if (headerEnd !== -1) {
          bodyContent = bodyContent.substring(headerEnd + '<!-- header-area-end -->'.length);
        } else {
          // Fallback to removing first <header>...</header>
          bodyContent = bodyContent.replace(/<header[^]*?<\/header>/i, '');
        }

        // Find footer-area or footer-three
        const footerStart = bodyContent.indexOf('<!-- footer-area -->') !== -1 ? 
          bodyContent.indexOf('<!-- footer-area -->') : 
          bodyContent.indexOf('<div class="footer-three');
          
        if (footerStart !== -1) {
          bodyContent = bodyContent.substring(0, footerStart);
        } else {
          // Fallback to removing last footer
          bodyContent = bodyContent.replace(/<div class="footer-three"[^]*?<\/div>/i, '');
        }
      } else {
        bodyContent = rawContent;
      }

      // Cleanup remaining layout wrapper closing tags or trail scripts
      // The bodyContent should only contain the inner page blocks
      // Clean links: change `.html` references to clean paths, and fix relative image/assets URLs
      bodyContent = bodyContent
        .replace(/href="([a-zA-Z0-9\-]+)\.html"/g, 'href="/$1"')
        .replace(/src="images\//g, 'src="/images/')
        .replace(/href="images\//g, 'href="/images/')
        .replace(/src="js\//g, 'src="/js/')
        .replace(/href="css\//g, 'href="/css/');

      return {
        params: { slug },
        props: { title, description, keywords, content: bodyContent }
      };
    });

  return paths;
}

const { title, description, keywords, content } = Astro.props;
---

<Layout title={title} description={description} keywords={keywords}>
  <Fragment set:html={content} />
</Layout>
