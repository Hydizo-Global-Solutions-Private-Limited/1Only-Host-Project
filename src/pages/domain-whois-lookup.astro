---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const title = "1Only Host - Reliable Web Hosting & Domain Services Provider";
const description = "1Only Host offers premium web hosting and domain services, providing fast, secure, and affordable solutions for businesses and individuals. Get started today!";
const keywords = "web hosting, domain services, reliable hosting, affordable hosting, secure hosting, domain registration, website hosting, cloud hosting, 1Only Host hosting, best web hosting, fast hosting services";
---

<Layout title={title} description={description} keywords={keywords}>
  <div class="hero-banner-eight bg-twelve z-1 position-relative pt-130 pb-160 xl-pb-140 md-p0 mesh-bg-1" data-aos="fade-in">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-10 text-center">
          <h1 class="hero-heading ">WHOIS <span> Lookup</span> </h1>
          <p class="fs-28  font-manrope pt-25 pb-25 pe-xxl-5">Check to see who has registered any Web address. If the Web address is available, you can register it through us</p>
          <div>
            <form action="#" class="m-auto d-flex align-items-center justify-content-between flex-wrap mb-15">
              <input type="name" placeholder="Domain Name..">
              <button>Search Domain</button>
            </form>
            <ul class="style-none d-flex flex-wrap justify-content-center">
              <li>
                <svg width="20" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 8.28571L7 13L16.8571 1" stroke="#8c32ff" stroke-width="2.5"/>
                </svg>
                No Card required</li>
              <li>
                <svg width="20" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 8.28571L7 13L16.8571 1" stroke="#8c32ff" stroke-width="2.5"/>
                </svg>
                14 Days Free Trial</li>
            </ul>
          </div>
        </div>
          
      </div>
      
    </div>
  </div>
  
  <section class="section-gap">
    <div class="container">
      <div class="row">
        <div class="col-xl-11 m-auto">
          <div class="title-four text-center mb-80 lg-mb-40 pe-xl-3 ps-xl-3">
            <h2 class="fw-bold">FREE Add-ons with every Domain Name!</h2>
          </div>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"> <i aria-hidden="true" class="icon icon-home"></i> </div>
              <h4>Free <span>Email Account </span></h4>
            </div>
            <p>Receive 2 personalized Email Addresses such as mail@ yourdomain.com with free fraud, spam and virus protection. </p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"> <i aria-hidden="true" class="icon icon-share"></i> </div>
              <h4>Domain <span> Forwarding</span></h4>
            </div>
            <p>Point your domain name to another website for free! Redirect users when they type your domain name into a browser (with/without domain masking & SEO)</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"> <i aria-hidden="true" class="icon icon-server-4"></i> </div>
              <h4>DNS  <span>Management</span></h4>
            </div>
            <p>Free lifetime DNS service which allows you to manage your DNS records on our globally distributed and highly redundant DNS infrastructure.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"> <i aria-hidden="true" class="icon icon-shield"></i> </div>
              <h4>Domain  <span>Theft Protection</span></h4>
            </div>
            <p>Protect your Domain from being transferred out accidentally or without your permission with our free Domain Theft Protection.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"> <i aria-hidden="true" class="icon icon-pencil"></i> </div>
              <h4>Free  <span>Mail Forwards</span></h4>
            </div>
            <p>Create free email forwards and automatically redirect your email to existing email accounts.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12">
          <div class="card-one">
            <div class="icon-width-heading">
              <div class="icon"> <i aria-hidden="true" class="icon icon-cog"></i> </div>
              <h4>Easy to use <span>Control Panel </span></h4>
            </div>
            <p>Use our intuitive Control Panel to manage your domain name, configure email accounts, renew your domain name and buy more services.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="feedback-section-nine position-relative z-1 pt-80 xl-pt-100 lg-pt-70 pb-130 lg-pb-80 ">
    <div class="container">
      <div class="text-center mb-70 lg-mb-30">
        <h2><span class="counter">12,0000</span>+</h2>
        <p class="fs-28  opacity-75">Customer love our product with more 20+ years reparation</p>
      </div>
    </div>
    <div class="wrapper">
      <div class="feedback-slider-six">
        <div class="item">
          <div class="feedback-block">
            <blockquote>“1Only Host’s reliable hosting and stellar support have been crucial for our startup’s growth.”</blockquote>
            <div class="d-flex align-items-center justify-content-between">
              <div class="name "><span class="fw-500">Sarah J.</span> Business Co-Founder</div>
              <img src="/images/icon-quote.svg" alt="" class="icon"> </div>
          </div>
        </div>
        <div class="item">
          <div class="feedback-block">
            <blockquote>“1Only Host’s has boosted our site’s performance and reliability. Their support is excellent!”</blockquote>
            <div class="d-flex align-items-center justify-content-between">
              <div class="name "><span class="fw-500">Mike R.</span> Business Owner</div>
              <img src="/images/icon-quote.svg" alt="" class="icon"> </div>
          </div>
        </div>
        <div class="item">
          <div class="feedback-block">
            <blockquote>“1Only Host’s offers great value and dependable service for my blog. Managing it has never been easier.”</blockquote>
            <div class="d-flex align-items-center justify-content-between">
              <div class="name "><span class="fw-500">Emily T.</span> Blogger</div>
              <img src="/images/icon-quote.svg" alt="" class="icon"> </div>
          </div>
        </div>
        <div class="item">
          <div class="feedback-block">
            <blockquote>“1Only Host’s has ensured our online presence runs smoothly with their dedicated service. We’re grateful!”</blockquote>
            <div class="d-flex align-items-center justify-content-between">
              <div class="name "><span class="fw-500">John K.</span> Business Director</div>
              <img src="/images/icon-quote.svg" alt="" class="icon"> </div>
          </div>
        </div>
      </div>
      <ul class="slider-arrows slick-arrow-one d-flex justify-content-center style-none mt-50">
        <li class="prev_b slick-arrow"><i class="icon icon-arrow-left"></i></li>
        <li class="next_b slick-arrow"><i class="icon icon-arrow-right"></i></li>
      </ul>
    </div>
  </div>
</Layout>
