---
import Layout from '../layouts/Layout.astro';
import windowHostingData from '../data/pages/window-shared-hosting.json';

export const prerender = true;

const data = windowHostingData;

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const basePrefix = pathSegments.length > 0 ? '../'.repeat(pathSegments.length) : './';
---

<Layout 
  title={data.seo.title} 
  description={data.seo.description} 
  keywords={data.seo.keywords}
>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- HERO SECTION — Cinematic with Currency Toggle -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="sh-hero position-relative overflow-hidden" data-aos="fade-in">
    <div class="sh-hero-bg position-absolute w-100 h-100 top-0 start-0" style={`background: url('${basePrefix}images/about-hero-datacenter.png') center/cover no-repeat;`}></div>
    <div class="sh-hero-overlay position-absolute w-100 h-100 top-0 start-0"></div>
    
    <div class="container position-relative z-2">
      <div class="row align-items-center sh-hero-inner">
        <div class="col-lg-7 py-5">
          <div class="d-inline-flex align-items-center mb-4 px-3 py-1 rounded-pill" style="background: rgba(0, 158, 255, 0.1); border: 1px solid rgba(0, 158, 255, 0.2);">
            <span style="background-color: #00F5D4; width: 8px; height: 8px; border-radius: 50%; display: inline-block; box-shadow: 0 0 6px #00F5D4;" class="me-2"></span>
            <span class="fs-12 text-white-50 uppercase tracking-widest fw-600">Premium Windows Hosting</span>
          </div>
          
          <h1 class="text-white fw-900 font-outfit mb-4" style="font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.08;">
            Windows Shared Hosting <span class="text-gradient">Power</span>
          </h1>
          
          <p class="text-white-50 fs-17 mb-4" style="max-width: 560px; line-height: 1.8;">
            {data.content.hero.subtitle}
          </p>
          
          <div class="d-flex flex-wrap align-items-center gap-4 mt-4">
            <a href="#pricing" class="btn-eighteen py-3 px-5 uppercase tracking-wider fs-13 fw-700">View Plans</a>
            <div class="text-white font-outfit fs-16 fw-500">
              Starting at 
              <span class="price-inr-hero"><span class="text-gradient fw-900 fs-28">₹{data.content.hero.price_start_inr}</span></span>
              <span class="price-usd-hero d-none"><span class="text-gradient fw-900 fs-28">${data.content.hero.price_start_usd}</span></span>
              <span class="opacity-50">/mo</span>
            </div>
          </div>
        </div>
        
        <div class="col-lg-5 d-none d-lg-block">
          <div class="glass-card p-2 rounded-4 position-relative overflow-hidden" style="border-color: rgba(0,158,255,0.12) !important;">
            <img src={`${basePrefix}images/shared-hosting-dashboard.png`} alt="Plesk Windows Dashboard" class="img-fluid rounded-4 w-100" style="height: 380px; object-fit: cover;">
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- TRUST BADGES STRIP -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-4 position-relative" style="border-bottom: 1px solid rgba(255,255,255,0.04);">
    <div class="container">
      <div class="row g-3 text-center">
        <div class="col-6 col-md">
          <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 fs-13 fw-600 font-outfit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Plesk Obsidian
          </div>
        </div>
        <div class="col-6 col-md">
          <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 fs-13 fw-600 font-outfit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M9 12l2 2 4-4"/></svg>
            MSSQL Support
          </div>
        </div>
        <div class="col-6 col-md">
          <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 fs-13 fw-600 font-outfit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8338EC" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            ASP.NET Core
          </div>
        </div>
        <div class="col-6 col-md">
          <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 fs-13 fw-600 font-outfit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            IIS 10.0 Web Server
          </div>
        </div>
        <div class="col-6 col-md">
          <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 fs-13 fw-600 font-outfit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF88" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
            SSD Performance
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- PRICING SECTION -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section id="pricing" class="py-100 position-relative" data-aos="fade-up">
    <div class="container">
      <div class="text-center mb-50">
        <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(0, 158, 255, 0.1); color: #00F5D4; border: 1px solid rgba(0, 158, 255, 0.2);">Pricing</span>
        <h2 class="text-white font-outfit fw-900 fs-36">{data.content.pricing.title}</h2>
        <p class="text-white-50 fs-16 mt-2 max-w-700 mx-auto">{data.content.pricing.subtitle}</p>
      </div>

      <!-- Currency + Billing Toggles -->
      <div class="d-flex flex-column flex-sm-row align-items-center justify-content-center gap-3 mb-50">
        <!-- Currency Toggle -->
        <div class="glass-card rounded-pill p-1 d-inline-flex" style="border-color: rgba(0,158,255,0.15) !important;">
          <button class="currency-toggle-btn rounded-pill fw-700 font-outfit border-0 px-4 py-2 text-white fs-13 active" data-currency="inr">
            ₹ INR
          </button>
          <button class="currency-toggle-btn rounded-pill fw-700 font-outfit border-0 px-4 py-2 text-white fs-13" data-currency="usd">
            $ USD
          </button>
        </div>
        
        <!-- Billing Cycle Toggle -->
        <div class="glass-card rounded-pill p-1 d-inline-flex flex-wrap" style="border-color: rgba(255,255,255,0.06) !important;">
          {data.content.pricing.cycles.map((cycle, index) => (
            <button class={`billing-toggle-btn rounded-pill fw-600 font-outfit border-0 px-3 py-2 text-white fs-13 ${index === 0 ? 'active' : ''}`} data-cycle={cycle}>
              {cycle}
            </button>
          ))}
        </div>
      </div>

      <!-- Pricing Cards -->
      <div class="row g-4 justify-content-center">
        {data.content.pricing.plans.map((plan, pIndex) => (
          <div class="col-xl-4 col-lg-6 col-md-6" data-aos="fade-up" data-aos-delay={pIndex * 80}>
            <div class={`sh-pricing-card glass-card h-100 rounded-4 p-4 d-flex flex-column position-relative ${plan.is_popular ? 'sh-popular' : ''}`} style={`border-color: ${plan.is_popular ? 'rgba(0,158,255,0.3)' : 'rgba(255,255,255,0.05)'} !important;`}>
              
              {plan.is_popular && (
                <div class="position-absolute top-0 start-50 translate-middle">
                  <span class="badge px-3 py-2 rounded-pill fw-800 font-outfit fs-10 uppercase tracking-widest text-white" style="background: linear-gradient(135deg, #00F5D4, #8338EC); box-shadow: 0 4px 15px rgba(0,245,212,0.3);">MOST POPULAR</span>
                </div>
              )}
              
              <h3 class="text-white font-outfit fw-800 uppercase tracking-wider fs-14 mb-3 mt-1">{plan.name}</h3>
              
              <!-- INR Pricing Block -->
              {data.content.pricing.cycles.map((cycle, cIndex) => {
                const priceINR = plan.prices_inr[cycle];
                const priceUSD = plan.prices_usd[cycle];
                return (
                  <>
                    <div class={`price-cycle-view price-inr price-${cycle} ${cIndex !== 0 ? 'd-none' : ''}`}>
                      {priceINR.discount && (
                        <div class="mb-1">
                          <span class="text-decoration-line-through opacity-40 text-white fs-13">₹{priceINR.regular}</span>
                          <span class="ms-2 fs-11 fw-700 text-white px-2 py-0.5 rounded" style="background: rgba(0,245,212,0.2); color: #00F5D4 !important;">{priceINR.discount}</span>
                        </div>
                      )}
                      <div class="d-flex align-items-baseline">
                        <span class="text-gradient font-outfit fw-900" style="font-size: 2.5rem; line-height: 1;">₹{priceINR.current}</span>
                        <span class="fs-14 opacity-50 text-white ms-1">{priceINR.period}</span>
                      </div>
                    </div>
                    <div class={`price-cycle-view price-usd price-${cycle} d-none`}>
                      {priceUSD.discount && (
                        <div class="mb-1">
                          <span class="text-decoration-line-through opacity-40 text-white fs-13">${priceUSD.regular}</span>
                          <span class="ms-2 fs-11 fw-700 text-white px-2 py-0.5 rounded" style="background: rgba(0,245,212,0.2); color: #00F5D4 !important;">{priceUSD.discount}</span>
                        </div>
                      )}
                      <div class="d-flex align-items-baseline">
                        <span class="text-gradient font-outfit fw-900" style="font-size: 2.5rem; line-height: 1;">${priceUSD.current}</span>
                        <span class="fs-14 opacity-50 text-white ms-1">{priceUSD.period}</span>
                      </div>
                    </div>
                  </>
                );
              })}
              
              <a href={plan.purchase_link_inr} class={`sh-cta-btn d-block text-center text-white fw-700 font-outfit rounded-pill py-3 mt-3 mb-3 fs-14 uppercase tracking-wider ${plan.is_popular ? 'sh-cta-primary' : 'sh-cta-outline'}`} data-link-inr={plan.purchase_link_inr} data-link-usd={plan.purchase_link_usd}>
                Get Started
              </a>
              
              <div class="sh-features-list flex-grow-1 mt-2">
                {plan.features.map(feature => (
                  <div class="d-flex align-items-start gap-2 mb-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00F5D4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
                    <span class="text-white-50 fs-13 font-inter">{feature}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- FEATURES GRID — with Image -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-100 position-relative" data-aos="fade-up" style="border-top: 1px solid rgba(255,255,255,0.04);">
    <div class="container">
      <div class="row g-5 align-items-center mb-60">
        <div class="col-lg-6">
          <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(0, 245, 212, 0.1); color: #00F5D4; border: 1px solid rgba(0, 245, 212, 0.2);">Included Specs</span>
          <h2 class="text-white font-outfit fw-900 fs-36">{data.content.features_grid.title}</h2>
          <p class="text-white-50 fs-16 mt-3" style="line-height: 1.7;">{data.content.features_grid.subtitle}</p>
        </div>
        <div class="col-lg-6">
          <div class="glass-card p-2 rounded-4" style="border-color: rgba(0,245,212,0.12) !important;">
            <img src={`${basePrefix}images/shared-hosting-speed.png`} alt="High Uptime Windows Performance" class="img-fluid rounded-4 w-100" style="height: 300px; object-fit: cover;">
          </div>
        </div>
      </div>
      
      <div class="row g-4">
        {data.content.features_grid.items.map((item, index) => (
          <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay={index * 60}>
            <div class="glass-card h-100 p-4 rounded-4 sh-feature-card" style="border-color: rgba(255,255,255,0.04) !important;">
              <div class="d-flex align-items-center justify-content-center rounded-3 mb-3" style={`width: 48px; height: 48px; background: ${index % 4 === 0 ? 'rgba(0,245,212,0.1)' : index % 4 === 1 ? 'rgba(255,0,127,0.1)' : index % 4 === 2 ? 'rgba(131,56,236,0.1)' : 'rgba(255,215,0,0.1)'}; border: 1px solid ${index % 4 === 0 ? 'rgba(0,245,212,0.2)' : index % 4 === 1 ? 'rgba(255,0,127,0.2)' : index % 4 === 2 ? 'rgba(131,56,236,0.2)' : 'rgba(255,215,0,0.2)'};`}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={index % 4 === 0 ? '#00F5D4' : index % 4 === 1 ? '#FF007F' : index % 4 === 2 ? '#8338EC' : '#FFD700'} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {index === 0 ? <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/> :
                   index === 1 ? <><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></> :
                   index === 2 ? <><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/></> :
                   index === 3 ? <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></> :
                   index === 4 ? <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></> :
                   index === 5 ? <><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></> :
                   index === 6 ? <><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></> :
                   <><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></>}
                </svg>
              </div>
              <h5 class="text-white font-outfit fw-700 mb-2 fs-16">{item.title}</h5>
              <p class="text-white-50 m-0 fs-13" style="line-height: 1.7;">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- COMPARISON TABLE -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-100 position-relative" data-aos="fade-up" style="border-top: 1px solid rgba(255,255,255,0.04);">
    <div class="container">
      <div class="text-center mb-60">
        <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(131, 56, 236, 0.1); color: #8338EC; border: 1px solid rgba(131, 56, 236, 0.2);">Comparison</span>
        <h2 class="text-white font-outfit fw-900 fs-36">{data.content.comparison.title}</h2>
        <p class="text-white-50 fs-16 mt-2 max-w-700 mx-auto">{data.content.comparison.subtitle}</p>
      </div>

      <div class="table-responsive glass-card rounded-4 p-4" style="border-color: rgba(255,255,255,0.06) !important;">
        <table class="table table-borderless align-middle m-0 sh-compare-table">
          <thead>
            <tr>
              <th scope="col" class="py-4 text-white-50 fw-500 font-outfit fs-15" style="width: 28%;">Features</th>
              <th scope="col" class="py-4 text-center text-white fw-800 font-outfit fs-15 uppercase">Win-Starter</th>
              <th scope="col" class="py-4 text-center fw-800 font-outfit fs-15 uppercase sh-popular-col">
                <span class="text-gradient">Win-Standard</span>
              </th>
              <th scope="col" class="py-4 text-center text-white fw-800 font-outfit fs-15 uppercase">Win-Professional</th>
            </tr>
          </thead>
          <tbody>
            {data.content.comparison.categories.map((cat) => (
              <>
                <tr>
                  <td colspan="4" class="pt-4 pb-2 font-outfit fw-700 text-gradient fs-14 uppercase tracking-widest">{cat.name}</td>
                </tr>
                {cat.rows.map(row => (
                  <tr class="sh-compare-row">
                    <td class="py-3 fw-500 text-white font-inter fs-14">{row.feature}</td>
                    <td class="py-3 text-center text-white-50 font-inter fs-14">{row.starter === '✓' ? <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF88" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> : row.starter === '—' ? <span class="opacity-25">—</span> : row.starter}</td>
                    <td class="py-3 text-center fw-600 text-white font-inter fs-14 sh-popular-col">{row.platinum === '✓' ? <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF88" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> : row.platinum}</td>
                    <td class="py-3 text-center text-white-50 font-inter fs-14">{row.advance === '✓' ? <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF88" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> : row.advance}</td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- WHY WINDOWS HOSTING — Tech Specs -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-100 position-relative" data-aos="fade-up" style="border-top: 1px solid rgba(255,255,255,0.04);">
    <div class="container">
      <div class="text-center mb-60">
        <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(255, 215, 0, 0.1); color: #FFD700; border: 1px solid rgba(255, 215, 0, 0.2);">Microsoft Stack</span>
        <h2 class="text-white font-outfit fw-900 fs-36">{data.content.suppliers.title}</h2>
        <p class="text-white-50 fs-16 mt-2 max-w-700 mx-auto">{data.content.suppliers.subtitle}</p>
      </div>
      
      <div class="row g-4">
        {data.content.suppliers.items.map((item, index) => (
          <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay={index * 80}>
            <div class="glass-card h-100 p-4 rounded-4 text-center sh-feature-card" style="border-color: rgba(255,255,255,0.05) !important;">
              <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style={`width: 60px; height: 60px; background: ${index === 0 ? 'rgba(0,245,212,0.1)' : index === 1 ? 'rgba(255,0,127,0.1)' : index === 2 ? 'rgba(131,56,236,0.1)' : 'rgba(255,215,0,0.1)'}; border: 1px solid ${index === 0 ? 'rgba(0,245,212,0.2)' : index === 1 ? 'rgba(255,0,127,0.2)' : index === 2 ? 'rgba(131,56,236,0.2)' : 'rgba(255,215,0,0.2)'};`}>
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke={index === 0 ? '#00F5D4' : index === 1 ? '#FF007F' : index === 2 ? '#8338EC' : '#FFD700'} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {index === 0 ? <><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></> :
                   index === 1 ? <><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></> :
                   index === 2 ? <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></> :
                   <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></>}
                </svg>
              </div>
              <h5 class="text-white font-outfit fw-700 mb-2 fs-17">{item.title}</h5>
              <p class="text-white-50 m-0 fs-13" style="line-height: 1.7;">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>




  <!-- ═══════════════════════════════════════════════════ -->
  <!-- CTA -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-80" data-aos="fade-up">
    <div class="container">
      <div class="sh-cta-banner text-center">
        <div class="position-relative z-2">
          <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3 d-inline-block" style="background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.1); border-radius: 20px;">🚀 IIS Server Deployments</span>
          <h2 class="text-white font-outfit fw-900 fs-36 mt-3 mb-3">Deploy Your ASP.NET App in Under 60 Seconds</h2>
          <p class="text-white-50 fs-16 max-w-700 mx-auto mb-4">Plesk panel setup, robust database architectures, IIS pooling and isolation. Instant provisioning.</p>
          <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="#pricing" class="btn-eighteen py-3 px-5 uppercase tracking-wider fs-13 fw-700">View Pricing</a>
            <a href="/contact" class="btn btn-outline-light py-3 px-5 uppercase tracking-wider fs-13 fw-600 rounded-pill" style="border-color: rgba(255,255,255,0.15);">Talk to an Expert</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>


<!-- ═══════════════════════════════════════════════════ -->
<!-- SCRIPTS — Currency Toggle + Billing Cycle Toggle -->
<!-- ═══════════════════════════════════════════════════ -->
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  let currentCurrency = 'inr';
  let currentCycle = 'Monthly';

  // === Currency Toggle ===
  const currencyBtns = document.querySelectorAll('.currency-toggle-btn');
  currencyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currencyBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentCurrency = btn.dataset.currency;
      updatePricing();
    });
  });

  // === Billing Cycle Toggle ===
  const billingBtns = document.querySelectorAll('.billing-toggle-btn');
  billingBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      billingBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentCycle = btn.dataset.cycle;
      updatePricing();
    });
  });

  function updatePricing() {
    // Hide all price views
    document.querySelectorAll('.price-cycle-view').forEach(v => v.classList.add('d-none'));
    
    // Show only matching currency + cycle
    const selector = `.price-${currentCurrency}.price-${currentCycle}`;
    document.querySelectorAll(selector).forEach(v => v.classList.remove('d-none'));

    // Update hero price
    document.querySelectorAll('.price-inr-hero').forEach(el => el.classList.toggle('d-none', currentCurrency !== 'inr'));
    document.querySelectorAll('.price-usd-hero').forEach(el => el.classList.toggle('d-none', currentCurrency !== 'usd'));

    // Update purchase links
    document.querySelectorAll('.sh-cta-btn').forEach(btn => {
      const link = currentCurrency === 'inr' ? btn.dataset.linkInr : btn.dataset.linkUsd;
      if (link) btn.href = link;
    });
  }
});
</script>


