  50% { box-shadow: 0 0 35px rgba(255, 158, 0, 0.7), 0 0 70px rgba(255, 0, 127, 0.35); }
}

/* Responsive: Stack on mobile */
@media (max-width: 991px) {
  .premium-timeline::before {
    left: 24px;
