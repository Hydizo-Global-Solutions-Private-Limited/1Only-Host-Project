---
import Layout from '../layouts/Layout.astro';
import DataCentersGlobe from '../components/DataCentersGlobe.astro';
import aboutData from '../data/pages/about-us.json';

export const prerender = true;

const data = aboutData;

// Compute dynamic basePrefix for relative path resolution
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const basePrefix = pathSegments.length > 0 ? '../'.repeat(pathSegments.length) : './';
---

<Layout 
  title={data.seo.title} 
  description={data.seo.description} 
  keywords={data.seo.keywords}
>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- HERO SECTION — Cinematic Datacenter Split -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="about-hero-section position-relative overflow-hidden" data-aos="fade-in">
    <!-- Background image with overlay -->
    <div class="hero-bg-image position-absolute w-100 h-100 top-0 start-0" style={`background: url('${basePrefix}images/about-hero-datacenter.png') center/cover no-repeat;`}></div>
    <div class="hero-overlay position-absolute w-100 h-100 top-0 start-0"></div>
    
    <div class="container position-relative z-2">
      <div class="row align-items-center min-vh-75">
        <div class="col-lg-7 py-5">
          <div class="d-inline-flex align-items-center mb-4 px-3 py-1 rounded-pill" style="background: rgba(255, 158, 0, 0.1); border: 1px solid rgba(255, 158, 0, 0.2);">
            <span class="status-dot pulsing me-2" style="background-color: #FF9E00; width: 8px; height: 8px; border-radius: 50%;"></span>
            <span class="fs-12 text-white-50 uppercase tracking-widest fw-600">Est. 2019 · Hyderabad, India</span>
          </div>
          
          <h1 class="text-white fw-900 font-outfit mb-4" style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.08;">
            We Don't Just Host Websites.<br>
            <span class="text-gradient">We Protect Dreams.</span>
          </h1>
          
          <p class="text-white-50 fs-18 mb-4" style="max-width: 560px; line-height: 1.8;">
            Born from a cybersecurity professional's frustration with insecure hosting, 1Only Host was built on one unshakeable principle: <strong class="text-white">your data deserves military-grade protection at an honest price.</strong>
          </p>
          
          <div class="d-flex flex-wrap gap-3 mt-4">
            <a href="/shared-hosting" class="btn-eighteen py-3 px-5 uppercase tracking-wider fs-13 fw-700">Explore Our Plans</a>
            <a href="#our-story" class="btn btn-outline-light py-3 px-5 uppercase tracking-wider fs-13 fw-600 rounded-pill" style="border-color: rgba(255,255,255,0.2);">Our Story ↓</a>
          </div>
          
          <!-- Hero Stats Row -->
          <div class="d-flex flex-wrap gap-4 mt-5 pt-4" style="border-top: 1px solid rgba(255,255,255,0.08);">
            <div>
              <div class="text-gradient font-outfit fw-900" style="font-size: 2rem; line-height: 1;">1000+</div>
              <div class="fs-12 text-white-50 uppercase tracking-widest mt-1">Businesses Served</div>
            </div>
            <div>
              <div class="text-gradient font-outfit fw-900" style="font-size: 2rem; line-height: 1;">99.9%</div>
              <div class="fs-12 text-white-50 uppercase tracking-widest mt-1">Uptime SLA</div>
            </div>
            <div>
              <div class="text-gradient font-outfit fw-900" style="font-size: 2rem; line-height: 1;">8+</div>
              <div class="fs-12 text-white-50 uppercase tracking-widest mt-1">Countries</div>
            </div>
            <div>
              <div class="text-gradient font-outfit fw-900" style="font-size: 2rem; line-height: 1;">24/7</div>
              <div class="fs-12 text-white-50 uppercase tracking-widest mt-1">Human Support</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- MISSION & VISION — Split Panels -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-100 position-relative" data-aos="fade-up">
    <div class="container lg">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6">
          <div class="glass-card p-2 rounded-4 position-relative overflow-hidden" style="border-color: rgba(255,158,0,0.15) !important;">
            <img src={`${basePrefix}images/about-mission-vision.png`} alt="Our Mission - Global Connectivity" class="img-fluid rounded-4 w-100" style="object-fit: cover; min-height: 400px;">
          </div>
        </div>
        <div class="col-lg-6">
          <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(255, 158, 0, 0.1); color: #FF9E00; border: 1px solid rgba(255, 158, 0, 0.2);">Our Purpose</span>
          
          <h2 class="text-white font-outfit fw-900 fs-36 mb-4">Mission & Vision</h2>
          
          <div class="glass-card p-4 rounded-4 mb-4" style="border-left: 3px solid #FF9E00 !important;">
            <h4 class="text-white font-outfit fw-700 mb-2 d-flex align-items-center gap-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Our Mission
            </h4>
            <p class="text-white-50 m-0 fs-15" style="line-height: 1.7;">To democratize enterprise-grade web hosting by making military-grade security, blazing speed, and transparent pricing accessible to every business — from a student's first blog to a Fortune 500 enterprise.</p>
          </div>
          
          <div class="glass-card p-4 rounded-4" style="border-left: 3px solid #FF007F !important;">
            <h4 class="text-white font-outfit fw-700 mb-2 d-flex align-items-center gap-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              Our Vision
            </h4>
            <p class="text-white-50 m-0 fs-15" style="line-height: 1.7;">To become Asia's most trusted hosting partner by building an ecosystem where technology, education, and community empower every entrepreneur to launch, grow, and protect their online presence without fear.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- CORE VALUES — Highlight Strip -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-60 position-relative" data-aos="fade-up">
    <div class="container lg">
      <div class="row g-4 text-center">
        <div class="col-6 col-lg-3">
          <div class="glass-card p-4 rounded-4 h-100" style="border-color: rgba(255,158,0,0.1) !important;">
            <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 52px; height: 52px; background: rgba(255,158,0,0.1); border: 1px solid rgba(255,158,0,0.2);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h5 class="text-white font-outfit fw-700 mb-1 fs-16">Security First</h5>
            <p class="text-white-50 m-0 fs-13">Every decision starts with protecting your data</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="glass-card p-4 rounded-4 h-100" style="border-color: rgba(255,0,127,0.1) !important;">
            <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 52px; height: 52px; background: rgba(255,0,127,0.1); border: 1px solid rgba(255,0,127,0.2);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
            </div>
            <h5 class="text-white font-outfit fw-700 mb-1 fs-16">Transparency</h5>
            <p class="text-white-50 m-0 fs-13">No hidden fees, no surprises — ever</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="glass-card p-4 rounded-4 h-100" style="border-color: rgba(131,56,236,0.1) !important;">
            <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 52px; height: 52px; background: rgba(131,56,236,0.1); border: 1px solid rgba(131,56,236,0.2);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8338EC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h5 class="text-white font-outfit fw-700 mb-1 fs-16">Community</h5>
            <p class="text-white-50 m-0 fs-13">We grow together with our users</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="glass-card p-4 rounded-4 h-100" style="border-color: rgba(255,215,0,0.1) !important;">
            <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 52px; height: 52px; background: rgba(255,215,0,0.1); border: 1px solid rgba(255,215,0,0.2);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <h5 class="text-white font-outfit fw-700 mb-1 fs-16">Innovation</h5>
            <p class="text-white-50 m-0 fs-13">Building tools that shape the future</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- FOUNDER'S STORY — Premium Alternating Timeline -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section id="our-story" class="py-100 position-relative" data-aos="fade-up" style="border-top: 1px solid rgba(255,255,255,0.04);">
    <div class="container lg">
      <div class="text-center mb-70">
        <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(255, 0, 127, 0.1); color: #FF007F; border: 1px solid rgba(255, 0, 127, 0.2);">Words By Our Founder</span>
        <h2 class="text-white font-outfit fw-900 fs-36">Our Journey</h2>
        <p class="text-white-50 fs-16 max-width-800 mx-auto mt-2">From losing 150+ client websites to building a technology brand trusted by thousands.</p>
      </div>

      <!-- Founder Portrait — Mobile Only -->
      <div class="d-block d-lg-none text-center mb-5">
        <div class="glass-card p-2 rounded-4 d-inline-block position-relative overflow-hidden mx-auto" style="border-color: rgba(255,158,0,0.15) !important; max-width: 300px;">
          <img src={`${basePrefix}images/founder_portrait.png`} alt="Ramandeep Singh Sethi - Founder" class="img-fluid rounded-4 w-100" style="height: 350px; object-fit: cover;">
          <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(0deg, rgba(2,4,10,0.95) 20%, transparent 100%);">
            <h6 class="text-white font-outfit fw-800 m-0 fs-15">Ramandeep Singh Sethi</h6>
            <span class="text-gradient fs-11 fw-700 uppercase tracking-widest">Founder & CEO</span>
          </div>
        </div>
      </div>
      
      <!-- Premium Timeline -->
      <div class="premium-timeline">
        {data.content.journey.sections.map((sec, index) => {
          const isLast = index === data.content.journey.sections.length - 1;
          const isEven = index % 2 === 0;
          return (
            <div class={`tl-row ${isEven ? 'tl-left' : 'tl-right'} ${isLast ? 'tl-current' : ''}`} data-aos={isEven ? 'fade-right' : 'fade-left'} data-aos-delay={index * 60}>
              
              {/* Center Spine */}
              <div class="tl-spine">
                <div class="tl-year-badge">
                  <span class="tl-year-text">{sec.year}</span>
                </div>
                {!isLast && <div class="tl-connector"></div>}
              </div>

              {/* Card */}
              <div class="tl-card-wrapper">
                <div class={`tl-card glass-card rounded-4 p-4 ${isLast ? 'tl-card-glow' : ''}`} style={isLast ? 'border-color: rgba(255,158,0,0.3) !important; background: rgba(255,158,0,0.03) !important;' : 'border-color: rgba(255,255,255,0.05) !important;'}>
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="tl-label-badge">{sec.label}</span>
                    {isLast && <span class="tl-now-badge">NOW</span>}
                  </div>
                  <h4 class="text-white font-outfit fw-700 mb-2 fs-20">{sec.heading}</h4>
                  <p class="text-white-50 m-0 fs-14" style="line-height: 1.75;">{sec.text}</p>
                </div>
                <div class="tl-arrow"></div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Founder Footer — Desktop -->
      <div class="d-none d-lg-flex align-items-center justify-content-center mt-60 gap-4" data-aos="fade-up">
        <div class="glass-card p-2 rounded-4 position-relative overflow-hidden" style="border-color: rgba(255,158,0,0.15) !important; width: 80px; height: 80px;">
          <img src={`${basePrefix}images/founder_portrait.png`} alt="Ramandeep Singh Sethi" class="rounded-4 w-100 h-100" style="object-fit: cover;">
        </div>
        <div>
          <h5 class="text-white font-outfit fw-800 m-0 fs-18">Ramandeep Singh Sethi</h5>
          <span class="text-gradient fs-12 fw-700 uppercase tracking-widest">Founder & CEO · 1Only Host</span>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- WHY CHOOSE US — Icon Grid with Image -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-100 position-relative" data-aos="fade-up" style="border-top: 1px solid rgba(255,255,255,0.04);">
    <div class="container lg">
      <div class="row g-5 align-items-center mb-60">
        <div class="col-lg-6">
          <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(255, 158, 0, 0.1); color: #FF9E00; border: 1px solid rgba(255, 158, 0, 0.2);">Why Partner With Us</span>
          <h2 class="text-white font-outfit fw-900 fs-36">{data.content.why_choose_us.title}</h2>
          <p class="text-white-50 fs-16 mt-3" style="line-height: 1.7;">{data.content.why_choose_us.subtitle}</p>
        </div>
        <div class="col-lg-6">
          <div class="glass-card p-2 rounded-4" style="border-color: rgba(255,158,0,0.12) !important;">
            <img src={`${basePrefix}images/about-team-support.png`} alt="24/7 Expert Support Team" class="img-fluid rounded-4 w-100" style="height: 300px; object-fit: cover;">
          </div>
        </div>
      </div>
      
      <div class="row g-4">
        {data.content.why_choose_us.reasons.map((reason, index) => (
          <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay={index * 80}>
            <div class="glass-card h-100 p-4 rounded-4 hover-lift" style="border-color: rgba(255,255,255,0.05) !important;">
              <div class="d-flex align-items-center justify-content-center rounded-3 mb-4" style={`width: 56px; height: 56px; background: ${index % 3 === 0 ? 'rgba(255,158,0,0.1)' : index % 3 === 1 ? 'rgba(255,0,127,0.1)' : 'rgba(131,56,236,0.1)'}; border: 1px solid ${index % 3 === 0 ? 'rgba(255,158,0,0.2)' : index % 3 === 1 ? 'rgba(255,0,127,0.2)' : 'rgba(131,56,236,0.2)'};`}>
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke={index % 3 === 0 ? '#FF9E00' : index % 3 === 1 ? '#FF007F' : '#8338EC'} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {index === 0 ? <><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></> :
                   index === 1 ? <><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></> :
                   index === 2 ? <><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></> :
                   index === 3 ? <><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></> :
                   index === 4 ? <><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></> :
                   <><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></>}
                </svg>
              </div>
              <h5 class="text-white font-outfit fw-700 mb-2 fs-18">{reason.title}</h5>
              <p class="text-white-50 m-0 fs-14" style="line-height: 1.7;">{reason.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- TECHNOLOGY STACK — with Security Image -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-100 position-relative" data-aos="fade-up" style="border-top: 1px solid rgba(255,255,255,0.04);">
    <div class="container lg">
      <div class="row g-5 align-items-center mb-60">
        <div class="col-lg-6 order-lg-2">
          <div class="glass-card p-2 rounded-4" style="border-color: rgba(255,0,127,0.12) !important;">
            <img src={`${basePrefix}images/about-security-shield.png`} alt="Enterprise-Grade Security" class="img-fluid rounded-4 w-100" style="height: 350px; object-fit: cover;">
          </div>
        </div>
        <div class="col-lg-6 order-lg-1">
          <span class="badge uppercase tracking-wider py-1 px-3 fs-10 mb-3" style="background: rgba(131, 56, 236, 0.1); color: #8338EC; border: 1px solid rgba(131, 56, 236, 0.2);">Our Tech Stack</span>
          <h2 class="text-white font-outfit fw-900 fs-36">{data.content.technology.title}</h2>
          <p class="text-white-50 fs-16 mt-3" style="line-height: 1.7;">{data.content.technology.subtitle}</p>
        </div>
      </div>
      
      <div class="row g-4">
        {data.content.technology.features.map((feature, index) => (
          <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay={index * 60}>
            <div class="glass-card h-100 p-4 rounded-4 tech-card-hover" style="border-color: rgba(255,255,255,0.04) !important;">
              <div class="d-flex align-items-center justify-content-center rounded-3 mb-3" style="width: 44px; height: 44px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {index === 0 ? <><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></> :
                   index === 1 ? <><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/></> :
                   index === 2 ? <><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></> :
                   index === 3 ? <><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></> :
                   index === 4 ? <><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></> :
                   index === 5 ? <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></> :
                   index === 6 ? <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></> :
                   <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></>}
                </svg>
              </div>
              <h5 class="text-white font-outfit fw-700 m-0 mb-2 fs-16">{feature.name}</h5>
              <p class="text-white-50 m-0 fs-14" style="line-height: 1.7;">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- DATA CENTERS — Interactive 3D Globe (Reusable Component) -->
  <!-- ═══════════════════════════════════════════════════ -->
  <DataCentersGlobe />


  <!-- ═══════════════════════════════════════════════════ -->
  <!-- PARTNERS — Logo Grid -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-80 position-relative" data-aos="fade-up" style="border-top: 1px solid rgba(255,255,255,0.04);">
    <div class="container lg">
      <div class="text-center mb-50">
        <h2 class="text-white font-outfit fw-900 fs-36 mb-3">The 1 Who Makes us Powerful</h2>
        <p class="text-white-50 fs-16">Industry-leading technology partners who power our infrastructure</p>
      </div>
      
      <div class="row justify-content-center g-4">
        <div class="col-6 col-md-4 col-lg-2">
          <div class="glass-card d-flex flex-column align-items-center justify-content-center text-center p-4 h-100 partner-hover" style="border-color: rgba(255,158,0,0.1) !important;">
            <img src={`${basePrefix}images/logos/cpanel.png`} alt="cPanel" width="48" height="48" class="mb-3 rounded">
            <span class="fs-14 fw-700 text-white font-outfit uppercase tracking-wider">cPanel</span>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="glass-card d-flex flex-column align-items-center justify-content-center text-center p-4 h-100 partner-hover" style="border-color: rgba(255,158,0,0.1) !important;">
            <img src={`${basePrefix}images/logos/cpguard.svg`} alt="cPGuard" width="100" height="30" class="mb-3">
            <span class="fs-14 fw-700 text-white font-outfit uppercase tracking-wider">cPGuard</span>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
