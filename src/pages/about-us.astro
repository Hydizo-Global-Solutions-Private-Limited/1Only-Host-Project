---
import Layout from '../layouts/Layout.astro';
import aboutData from '../data/pages/about-us.json';

export const prerender = true;

const data = aboutData;

// Compute dynamic basePrefix for relative path resolution
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const basePrefix = pathSegments.length > 0 ? '../'.repeat(pathSegments.length) : './';
---

<Layout 
  title={data.seo.title} 
  description={data.seo.description} 
  keywords={data.seo.keywords}
>
  <!-- Hero Section -->
  <div class="hero-banner-eight bg-twelve z-1 position-relative pt-150 pb-120 mesh-bg-1" data-aos="fade-in">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <h1 class="hero-heading fw-900 font-outfit" style="font-size: 3.5rem; line-height: 1.1;">{data.content.hero.title}</h1>
          <p class="fs-22 font-inter pt-25 pb-15 pe-xxl-5 opacity-75 lh-base">{data.content.hero.subtitle}</p>
          <a href="https://my.1onlyhost.com/store/free-trial/30-day" class="btn-eight mt-20 hover-scale">Experience a 30 days free trial today</a>
        </div>
        <div class="col-lg-6 mt-5 mt-lg-0 text-center">
            <div class="hero-img-wrapper position-relative inline-block float-animation">
               <div class="glow-backdrop position-absolute w-100 h-100 rounded-4 top-0 start-0" style="background: linear-gradient(45deg, rgba(255,158,0,0.3), rgba(255,0,127,0.3)); filter: blur(30px); z-index: -1;"></div>
               <img src={`${basePrefix}images/datacenter.png`} alt="Data Center" class="img-fluid rounded-4 shadow-lg w-100 border border-light border-opacity-10" style="max-height: 450px; object-fit: cover;">
            </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Why Choose Us -->
  <div class="feature-section-why z-1 pt-100 pb-100 bg-twelve position-relative border-top border-light border-opacity-10">
    <div class="container">
      <div class="row align-items-center mb-60">
        <div class="col-lg-6 mb-4 mb-lg-0 text-center text-lg-start">
          <div class="title-eleven">
            <h2 class="text-white font-outfit fw-800">{data.content.why_choose_us.title}</h2>
            <p class="fs-20 opacity-75 mt-3">{data.content.why_choose_us.subtitle}</p>
          </div>
        </div>
        <div class="col-lg-6">
           <div class="glass-card p-2 rounded-4 float-animation premium-border">
              <img src={`${basePrefix}images/team-collab.png`} alt="Team Collaboration" class="img-fluid rounded-4 shadow-lg w-100" style="max-height: 300px; object-fit: cover;">
           </div>
        </div>
      </div>
      <div class="row g-4">
        {data.content.why_choose_us.reasons.map((reason, index) => (
          <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay={index * 100}>
            <div class="glass-card h-100 p-5 rounded-4 hover-lift premium-border">
              <div class="icon-box d-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 70px; height: 70px; background: rgba(255,158,0,0.1); border: 1px solid rgba(255,158,0,0.2);">
                <i class={`${reason.icon} fs-2 text-gradient`}></i>
              </div>
              <h4 class="text-white mb-3 font-outfit fw-600">{reason.title}</h4>
              <p class="fs-16 opacity-75 m-0 text-white font-inter lh-lg">{reason.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Our Journey -->
  <section class="section-gap pt-100 pb-100 bg-twelve" data-aos="fade-up">
    <div class="container lg">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-5 mb-lg-0">
          <div class="title-eleven mb-50">
            <h2 class="text-white font-outfit fw-800">{data.content.journey.title}</h2>
            <p class="fs-22 text-gradient fw-600 font-outfit">{data.content.journey.subtitle}</p>
          </div>
          <div class="journey-text text-white opacity-75 font-inter">
            {data.content.journey.sections.map((sec, index) => (
              <div class="mb-4" data-aos="fade-up" data-aos-delay={index * 100}>
                <h4 class="text-white mb-2 fs-22 font-outfit fw-600">{sec.heading}</h4>
                <p class="mb-0 lh-lg">{sec.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="col-lg-6 text-center">
          <div class="glass-card p-2 rounded-4 float-animation-slow premium-border">
             <img src={`${basePrefix}images/founder_portrait.png`} alt="Ramandeep Singh Sethi - Founder" class="img-fluid rounded-4 shadow-lg w-100" style="min-height: 450px; object-fit: cover;">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Innovative Technology -->
  <div class="technology-section pt-100 pb-100 bg-twelve border-top border-light border-opacity-10">
    <div class="container">
       <div class="title-eleven text-center mb-60">
        <h2 class="text-white font-outfit fw-800">{data.content.technology.title}</h2>
        <p class="fs-20 opacity-75 mt-3">{data.content.technology.subtitle}</p>
      </div>
      <div class="row g-4">
        {data.content.technology.features.map((feature, index) => (
          <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay={index * 50}>
            <div class="glass-card h-100 p-4 rounded-4 tech-card hover-lift premium-border">
               <div class="d-flex align-items-center mb-3">
                 <div class="icon-wrapper d-flex align-items-center justify-content-center rounded-3 me-3" style="width: 45px; height: 45px; background: rgba(255,255,255,0.05);">
                    <i class={`${feature.icon} fs-4 text-gradient`}></i>
                 </div>
                 <h5 class="text-white m-0 font-outfit fw-600 fs-18">{feature.name}</h5>
               </div>
               <p class="fs-15 opacity-75 text-white m-0 font-inter lh-lg">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Data Centers -->
  <section class="datacenters-section pt-100 pb-100 position-relative border-top border-light border-opacity-10 bg-twelve" data-aos="fade-up">
     <div class="container">
        <div class="row align-items-center">
           <div class="col-lg-5 mb-5 mb-lg-0 text-center text-lg-start">
              <div class="title-eleven mb-50">
                <h2 class="text-white font-outfit fw-800">{data.content.datacenters.title}</h2>
                <p class="fs-18 opacity-75 mt-3">{data.content.datacenters.subtitle}</p>
              </div>
              <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                {data.content.datacenters.locations.map((loc, index) => (
                   <div class="live-server-badge glass-card rounded-pill text-white px-4 py-2 fs-15 hover-glow premium-border d-flex align-items-center font-outfit fw-500" data-aos="zoom-in" data-aos-delay={index * 50}>
                      <span class="pulsing-dot me-2"></span> {loc}
                   </div>
                ))}
              </div>
           </div>
           <div class="col-lg-7 text-center">
              <div class="glass-card p-2 rounded-4 float-animation-slow premium-border">
                 <img src={`${basePrefix}images/global-map.png`} alt="Global Infrastructure Map" class="img-fluid rounded-4 shadow-lg w-100" style="object-fit: cover;">
              </div>
           </div>
        </div>
     </div>
  </section>

  <!-- Partners Section (Marquee) -->
  <div class="partners-section pt-100 pb-100 bg-twelve border-top border-light border-opacity-10 overflow-hidden">
    <div class="container text-center mb-50">
      <div class="title-eleven">
        <h2 class="text-white font-outfit fw-800">{data.content.partners.title}</h2>
        <p class="fs-18 opacity-75 mt-3">{data.content.partners.subtitle}</p>
      </div>
    </div>
    <div class="marquee-wrapper">
      <div class="marquee-content">
        <!-- Double the items for infinite scroll effect -->
        {data.content.partners.items.map((partner) => (
           <div class="partner-badge glass-card px-5 py-3 rounded-3 text-white fw-bold fs-18 text-uppercase font-outfit mx-3 d-inline-flex align-items-center justify-content-center premium-border" style="min-width: 200px;">
              {partner}
           </div>
        ))}
        {data.content.partners.items.map((partner) => (
           <div class="partner-badge glass-card px-5 py-3 rounded-3 text-white fw-bold fs-18 text-uppercase font-outfit mx-3 d-inline-flex align-items-center justify-content-center premium-border" style="min-width: 200px;">
              {partner}
           </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Blog Static View -->
  <div class="blog-section pt-100 pb-100 bg-twelve border-top border-light border-opacity-10">
    <div class="container">
      <div class="title-eleven text-center mb-60">
        <h2 class="text-white font-outfit fw-800">{data.content.blog.title}</h2>
        <p class="fs-20 opacity-75 mt-3">{data.content.blog.subtitle}</p>
      </div>
      <div class="row g-4">
         <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
            <div class="glass-card h-100 p-5 rounded-4 hover-lift premium-border d-flex flex-column">
               <span class="text-gradient fw-bold fs-13 text-uppercase letter-spacing-1 mb-3 font-inter">November 19, 2024</span>
               <h4 class="text-white mb-3 font-outfit fw-600">Arch Linux vs Gentoo: Which One is Right for You?</h4>
               <p class="text-white opacity-75 fs-15 font-inter lh-lg mb-4 flex-grow-1">Wondering whether Arch Linux or Gentoo is the better choice for your system? In this detailed comparison, we break down...</p>
               <a href="https://1onlyhost.com/arch-linux-vs-gentoo-which-one-is-right-for-you/" class="text-gradient fw-bold text-decoration-none d-inline-flex align-items-center font-outfit animated-link">
                  Read More <i class="bi bi-arrow-right ms-2 transition-transform"></i>
               </a>
            </div>
         </div>
         <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
            <div class="glass-card h-100 p-5 rounded-4 hover-lift premium-border d-flex flex-column">
               <span class="text-gradient fw-bold fs-13 text-uppercase letter-spacing-1 mb-3 font-inter">November 19, 2024</span>
               <h4 class="text-white mb-3 font-outfit fw-600">How to Set Up Payment Gateways in WHMCS: A Simple Guide</h4>
               <p class="text-white opacity-75 fs-15 font-inter lh-lg mb-4 flex-grow-1">Setting up payment gateways in WHMCS doesn't have to be complicated. Follow this simple guide to configure PayPal, Stripe, and...</p>
               <a href="https://1onlyhost.com/how-to-setup-payment-gateways-whmcs/" class="text-gradient fw-bold text-decoration-none d-inline-flex align-items-center font-outfit animated-link">
                  Read More <i class="bi bi-arrow-right ms-2 transition-transform"></i>
               </a>
            </div>
         </div>
         <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
            <div class="glass-card h-100 p-5 rounded-4 hover-lift premium-border d-flex flex-column">
               <span class="text-gradient fw-bold fs-13 text-uppercase letter-spacing-1 mb-3 font-inter">November 19, 2024</span>
               <h4 class="text-white mb-3 font-outfit fw-600">Litespeed vs Apache vs Nginx: Which Web Server is Best for Your Website?</h4>
               <p class="text-white opacity-75 fs-15 font-inter lh-lg mb-4 flex-grow-1">Choosing the right web server is key to your website's success. In this post, we compare Litespeed vs Apache vs...</p>
               <a href="https://1onlyhost.com/litespeed-vs-apache-vs-nginx/" class="text-gradient fw-bold text-decoration-none d-inline-flex align-items-center font-outfit animated-link">
                  Read More <i class="bi bi-arrow-right ms-2 transition-transform"></i>
               </a>
            </div>
         </div>
      </div>
      <div class="text-center mt-5" data-aos="fade-up" data-aos-delay="400">
         <a href="https://1onlyhost.com/blog/" class="btn-eight hover-scale">Load More</a>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <section class="faq-section pt-100 pb-120 bg-twelve border-top border-light border-opacity-10 position-relative" data-aos="fade-in">
    <div class="glow-backdrop position-absolute w-100 h-100 top-0 start-0" style="background: radial-gradient(circle at 50% 100%, rgba(255,0,127,0.05) 0%, transparent 60%); z-index: -1;"></div>
    <div class="container">
       <div class="title-eleven text-center mb-60">
        <h2 class="text-white font-outfit fw-800">{data.content.faq.title}</h2>
        <p class="fs-20 opacity-75 mt-3">{data.content.faq.subtitle}</p>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="accordion accordion-flush" id="faqAccordion">
            {data.content.faq.items.map((item, index) => (
               <div class="accordion-item bg-transparent border-bottom border-light border-opacity-10 mb-3" data-aos="fade-up" data-aos-delay={index * 50}>
                  <h2 class="accordion-header" id={`heading${index}`}>
                    <button class="accordion-button collapsed bg-transparent text-white fs-20 fw-600 py-4 shadow-none font-outfit" type="button" data-bs-toggle="collapse" data-bs-target={`#collapse${index}`} aria-expanded="false" aria-controls={`collapse${index}`}>
                      {item.q}
                    </button>
                  </h2>
                  <div id={`collapse${index}`} class="accordion-collapse collapse" aria-labelledby={`heading${index}`} data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-white opacity-75 pt-0 pb-4 fs-16 lh-lg font-inter">
                      {item.a}
                    </div>
                  </div>
               </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
.font-outfit {
  font-family: 'Outfit', sans-serif;
}
.font-inter {
  font-family: 'Inter', sans-serif;
}
.letter-spacing-1 {
  letter-spacing: 1px;
}
.text-gradient {
  background: linear-gradient(90deg, #FF9E00, #FF007F);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hover-lift {
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
}
.hover-lift:hover {
  transform: translateY(-8px);
  box-shadow: 0 15px 30px rgba(0,0,0,0.4);
}
.hover-glow {
  transition: box-shadow 0.3s ease, border-color 0.3s ease;
}
.hover-glow:hover {
  box-shadow: 0 0 20px rgba(255, 158, 0, 0.3);
  border-color: rgba(255, 158, 0, 0.5) !important;
}
.hover-scale {
  transition: transform 0.3s ease;
}
.hover-scale:hover {
  transform: scale(1.05);
}
.glass-card {
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
}
.premium-border {
  border: 1px solid rgba(255, 255, 255, 0.06);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
}
.btn-eight {
  background: linear-gradient(90deg, #FF9E00, #FF007F);
  color: #fff;
  padding: 14px 34px;
  border-radius: 40px;
  text-decoration: none;
  font-weight: 700;
  display: inline-block;
  transition: opacity 0.3s, transform 0.3s;
  border: none;
  box-shadow: 0 8px 20px rgba(255, 0, 127, 0.3);
}
.btn-eight:hover {
  opacity: 0.9;
  color: #fff;
}
.mesh-bg-1 {
  background-image: radial-gradient(at 0% 0%, hsla(253,16%,7%,1) 0, transparent 50%), radial-gradient(at 50% 0%, hsla(225,39%,30%,0.2) 0, transparent 50%), radial-gradient(at 100% 0%, hsla(339,49%,30%,0.2) 0, transparent 50%);
}
.bg-twelve {
  background-color: #0d0f12;
}
.accordion-button::after {
  filter: invert(1);
  transition: transform 0.3s ease;
}
.accordion-button:not(.collapsed) {
  background-color: transparent;
  color: #fff;
  box-shadow: none;
}
.accordion-button:not(.collapsed)::after {
  filter: invert(0.5) sepia(1) saturate(5) hue-rotate(320deg);
}

/* Float Animations */
.float-animation {
  animation: float 6s ease-in-out infinite;
}
.float-animation-slow {
  animation: float 8s ease-in-out infinite;
}
@keyframes float {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-15px); }
  100% { transform: translateY(0px); }
}

/* Pulsing Dot for Live Servers */
.pulsing-dot {
  width: 10px;
  height: 10px;
  background-color: #00FF88;
  border-radius: 50%;
  position: relative;
  box-shadow: 0 0 10px #00FF88;
}
.pulsing-dot::after {
  content: '';
  position: absolute;
  top: -4px;
  left: -4px;
  right: -4px;
  bottom: -4px;
  border: 2px solid #00FF88;
  border-radius: 50%;
  animation: pulse 2s linear infinite;
  opacity: 0;
}
@keyframes pulse {
  0% { transform: scale(0.5); opacity: 0.8; }
  100% { transform: scale(2); opacity: 0; }
}

/* Infinite Marquee */
.marquee-wrapper {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  position: relative;
}
/* Subtle fade on edges of marquee */
.marquee-wrapper::before,
.marquee-wrapper::after {
  content: '';
  position: absolute;
  top: 0;
  width: 150px;
  height: 100%;
  z-index: 2;
}
.marquee-wrapper::before {
  left: 0;
  background: linear-gradient(to right, #0d0f12, transparent);
}
.marquee-wrapper::after {
  right: 0;
  background: linear-gradient(to left, #0d0f12, transparent);
}
.marquee-content {
  display: inline-block;
  animation: marquee 25s linear infinite;
}
.marquee-content:hover {
  animation-play-state: paused;
}
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Blog Read More Arrow Hover */
.animated-link:hover .transition-transform {
  transform: translateX(5px);
}
.transition-transform {
  transition: transform 0.3s ease;
}
</style>
