/* ===== Premium Alternating Timeline ===== */
.premium-timeline {
  position: relative;
  max-width: 1000px;
  margin: 0 auto;
}

/* Center spine line */
.premium-timeline::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3px;
  background: linear-gradient(180deg, #FF9E00 0%, #FF007F 50%, #8338EC 100%);
  transform: translateX(-50%);
  border-radius: 3px;
}

/* Each timeline row */
.tl-row {
  display: flex;
  align-items: flex-start;
  position: relative;
  margin-bottom: 30px;
}

/* Spine (center column) */
.tl-spine {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Year badge */
.tl-year-badge {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9E00, #FF007F);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20px rgba(255, 158, 0, 0.35), 0 0 40px rgba(255, 0, 127, 0.15);
  border: 3px solid #02040A;
  position: relative;
  z-index: 6;
}

.tl-year-text {
  font-family: 'Outfit', sans-serif;
  font-weight: 900;
  font-size: 15px;
  color: #fff;
  letter-spacing: 0.5px;
}

/* Connector between badges */
.tl-connector {
  width: 3px;
  height: 40px;
  background: transparent; /* spine line handles this */
}

/* Card wrapper positioning */
.tl-card-wrapper {
  width: calc(50% - 52px);
  position: relative;
}

/* Left cards */
.tl-left .tl-card-wrapper {
  margin-right: auto;
  margin-left: 0;
  padding-right: 20px;
}

/* Right cards */
.tl-right .tl-card-wrapper {
  margin-left: auto;
  margin-right: 0;
  padding-left: 20px;
}

/* Arrow pointing to spine */
.tl-arrow {
  position: absolute;
  top: 24px;
  width: 0;
  height: 0;
  border-style: solid;
}

.tl-left .tl-arrow {
  right: 8px;
  border-width: 10px 0 10px 12px;
  border-color: transparent transparent transparent rgba(255, 255, 255, 0.03);
}

.tl-right .tl-arrow {
  left: 8px;
  border-width: 10px 12px 10px 0;
  border-color: transparent rgba(255, 255, 255, 0.03) transparent transparent;
}

/* Card hover */
.tl-card {
  transition: all 0.3s ease;
}
.tl-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(255, 158, 0, 0.08) !important;
  border-color: rgba(255, 158, 0, 0.2) !important;
}

/* Current era card glow */
.tl-card-glow {
  box-shadow: 0 0 30px rgba(255, 158, 0, 0.08), 0 0 60px rgba(255, 0, 127, 0.04) !important;
}

/* Label badge */
.tl-label-badge {
