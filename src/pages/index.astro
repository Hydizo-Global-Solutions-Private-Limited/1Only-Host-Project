// Testimonials video feedback modal
function initVideoModal() {
    const modal = document.getElementById('video-feedback-modal');
    const overlay = document.getElementById('modal-close-overlay');
    const closeBtn = document.getElementById('modal-close-btn');
    const clientName = document.getElementById('modal-client-name');
    const videoStatus = document.getElementById('modal-video-status');
    
    const playBtn = document.getElementById('mock-play-btn');
    const rewindBtn = document.getElementById('mock-rewind-btn');
    
    if (!modal || !overlay || !closeBtn || !clientName) return;
    
    const triggers = document.querySelectorAll('.video-feedback-trigger');
    let isPlaying = true;
    let currentText = '';
    
    triggers.forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            e.preventDefault();
            const name = trigger.getAttribute('data-client') || 'Client Testimonial';
            clientName.innerText = name;
            videoStatus.innerText = `Connecting to testimonial feed for ${name}...`;
            modal.classList.remove('d-none');
            document.body.style.overflow = 'hidden';
            isPlaying = true;
            if (playBtn) playBtn.innerText = 'Pause Feed';
            
            // Extract the actual feedback text from trigger card paragraph
            const paragraph = trigger.querySelector('p');
            currentText = paragraph ? paragraph.innerText.replace(/"/g, '') : '';
            
            // Speech Synthesis
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(currentText);
                utterance.rate = 0.95;
                utterance.volume = 1.0;
                utterance.pitch = 1.0;
                
                utterance.onend = () => {
                    if (isPlaying) {
                        videoStatus.innerText = `Finished audio playback for ${name}.`;
                        isPlaying = false;
                        if (playBtn) playBtn.innerText = 'Restart Audio';
                    }
                };
                
                // Speak after connection delay
                setTimeout(() => {
                    if (isPlaying) {
                        videoStatus.innerText = `Streaming high-fidelity video & audio feedback for ${name} [Active]`;
                        window.speechSynthesis.speak(utterance);
                    }
                }, 1000);
            } else {
                setTimeout(() => {
                    if (isPlaying) {
                        videoStatus.innerText = `Streaming high-fidelity video feedback for ${name} [Active]`;
                    }
                }, 1200);
            }
        });
    });
    
    function closeModal() {
        modal.classList.add('d-none');
        document.body.style.overflow = '';
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
        }
    }
    
    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', closeModal);
    
    if (playBtn) {
        playBtn.addEventListener('click', () => {
            if ('speechSynthesis' in window) {
                if (window.speechSynthesis.speaking) {
                    if (window.speechSynthesis.paused) {
                        window.speechSynthesis.resume();
                        isPlaying = true;
                        playBtn.innerText = 'Pause Feed';
                        videoStatus.innerText = 'Streaming feed active...';
                    } else {
                        window.speechSynthesis.pause();
                        isPlaying = false;
                        playBtn.innerText = 'Resume Feed';
                        videoStatus.innerText = 'Feed paused.';
                    }
                } else {
                    // Restart audio
                    window.speechSynthesis.cancel();
                    const utterance = new SpeechSynthesisUtterance(currentText);
                    utterance.rate = 0.95;
                    utterance.onend = () => {
                        videoStatus.innerText = `Finished audio playback.`;
                        if (playBtn) playBtn.innerText = 'Restart Audio';
                    };
                    window.speechSynthesis.speak(utterance);
                    isPlaying = true;
                    playBtn.innerText = 'Pause Feed';
                    videoStatus.innerText = 'Streaming feed active...';
                }
            } else {
                isPlaying = !isPlaying;
                if (isPlaying) {
                    playBtn.innerText = 'Pause Feed';
                    videoStatus.innerText = 'Streaming feed active...';
                } else {
                    playBtn.innerText = 'Resume Feed';
                    videoStatus.innerText = 'Feed paused.';
                }
            }
        });
    }
    
    if (rewindBtn) {
        rewindBtn.addEventListener('click', () => {
            videoStatus.innerText = 'Reconnecting to stream...';
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(currentText);
                utterance.rate = 0.95;
                utterance.onend = () => {
                    videoStatus.innerText = `Finished audio playback.`;
                    if (playBtn) playBtn.innerText = 'Restart Audio';
                };
                setTimeout(() => {
                    videoStatus.innerText = 'Streaming feed active...';
                    window.speechSynthesis.speak(utterance);
                    isPlaying = true;
                    if (playBtn) playBtn.innerText = 'Pause Feed';
                }, 600);
            } else {
                setTimeout(() => {
                    videoStatus.innerText = 'Streaming feed active...';
                }, 600);
            }
        });
    }
}

