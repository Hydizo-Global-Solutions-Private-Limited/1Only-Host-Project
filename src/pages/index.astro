// Countdown timer script
function initCountdown() {
    const targetDate = new Date();
    // Setting count down end to end of month dynamically to keep active
    targetDate.setDate(targetDate.getDate() + 4);
    
    const daysEl = document.getElementById('timer-days');
    const hoursEl = document.getElementById('timer-hours');
    const minsEl = document.getElementById('timer-mins');
    const secsEl = document.getElementById('timer-secs');
    
    if (!daysEl || !hoursEl || !minsEl || !secsEl) return;
    
    function updateTimer() {
        const now = new Date().getTime();
        const distance = targetDate.getTime() - now;
        
        if (distance < 0) {
            targetDate.setDate(new Date().getDate() + 4);
            return;
        }
        
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);
        
        daysEl.innerText = String(days).padStart(2, '0');
        hoursEl.innerText = String(hours).padStart(2, '0');
        minsEl.innerText = String(minutes).padStart(2, '0');
        secsEl.innerText = String(seconds).padStart(2, '0');
    }
    
    updateTimer();
    setInterval(updateTimer, 1000);
}

// Coupon click copy
function initCouponCopy() {
    const couponContainer = document.getElementById('coupon-container');
    const couponText = document.getElementById('coupon-text');
    const copyToast = document.getElementById('coupon-copy-toast');
    
    if (!couponContainer || !couponText) return;
    
    couponContainer.addEventListener('click', () => {
        const code = couponText.innerText.trim();
        navigator.clipboard.writeText(code).then(() => {
            if (copyToast) {
                copyToast.classList.add('show');
                setTimeout(() => {
                    copyToast.classList.remove('show');
                }, 2000);
            }
        }).catch(err => {
            console.error('Copy failed:', err);
        });
    });
}

// Domain availability HUD with Scanning Loader simulation
function initDomainHUD() {
    const searchForm = document.getElementById('domain-search-form');
    const searchInput = document.getElementById('domain-search-input');
    const searchingLoader = document.getElementById('domain-searching-loader');
    const hudResults = document.getElementById('domain-hud-results');
    const searchedName = document.getElementById('searched-domain-name');
    const primaryResult = document.getElementById('primary-domain-result');
    const primaryPrice = document.getElementById('primary-domain-price');
    const altDomain1 = document.getElementById('alt-domain-1');
    const altPrice1 = document.getElementById('alt-price-1');
    const altDomain2 = document.getElementById('alt-domain-2');
    const altPrice2 = document.getElementById('alt-price-2');
    const closeBtn = document.getElementById('close-hud-btn');

    if (!searchForm || !searchInput || !hudResults || !searchingLoader) return;

    searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const rawInput = searchInput.value.trim().toLowerCase();
        if (!rawInput) return;

        // Strip http/https/www
        let domain = rawInput.replace(/^(https?:\/\/)?(www\.)?/, '');
        if (!domain.includes('.')) {
            domain += '.com';
        }

        const baseName = domain.split('.')[0];
        const primaryExt = domain.substring(domain.indexOf('.'));

        // Reset display
        hudResults.classList.add('d-none');
        searchingLoader.classList.remove('d-none');
        const submitBtn = searchForm.querySelector('button');
        if (submitBtn) submitBtn.disabled = true;

        setTimeout(() => {
            searchingLoader.classList.add('d-none');
            if (submitBtn) submitBtn.disabled = false;

            searchedName.innerText = domain;
            primaryResult.innerText = domain;
            
            let rate = '₹ 1095/yr';
            if (primaryExt === '.in') rate = '₹ 599/yr';
            else if (primaryExt === '.net') rate = '₹ 1099/yr';
            else if (primaryExt === '.org') rate = '₹ 999/yr';
            else if (primaryExt === '.digital') rate = '₹ 399/yr';
            else if (primaryExt === '.site') rate = '₹ 149/yr';
            
            primaryPrice.innerText = rate;

            const ext1 = primaryExt === '.com' ? '.in' : '.com';
            const ext2 = primaryExt === '.net' ? '.org' : '.net';

            altDomain1.innerText = baseName + ext1;
            altPrice1.innerText = ext1 === '.in' ? '₹ 599/yr' : '₹ 1095/yr';

            altDomain2.innerText = baseName + ext2;
            altPrice2.innerText = ext2 === '.net' ? '₹ 1099/yr' : '₹ 999/yr';

            hudResults.classList.remove('d-none');
            hudResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 1200);
    });

    if (closeBtn) {
        closeBtn.addEventListener('click', () => {
            hudResults.classList.add('d-none');
        });
    }
}

