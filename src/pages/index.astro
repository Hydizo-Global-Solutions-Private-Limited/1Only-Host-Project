---
import Layout from '../layouts/Layout.astro';
import homepageData from '../data/pages/home.json';

export const prerender = true;

const data = homepageData;

// Compute dynamic basePrefix for relative path resolution
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const basePrefix = pathSegments.length > 0 ? '../'.repeat(pathSegments.length) : './';
---

<Layout 
  title={data.seo.title || "Bring Your Vision to Life with Best Hosting Company in India | 1Only Host"} 
  description={data.seo.description} 
  keywords={data.seo.keywords}
>
<div class="homepage-custom-font">
  <!-- Scroll Progress Bar -->
  <div id="scroll-progress-bar" class="scroll-progress-bar"></div>

  <!-- Floating Particles Decoration -->
  <div class="floating-particles" aria-hidden="true">
    <div class="particle particle-1"></div>
    <div class="particle particle-2"></div>
    <div class="particle particle-3"></div>
    <div class="particle particle-4"></div>
    <div class="particle particle-5"></div>
    <div class="particle particle-6"></div>
  </div>

  <!-- Promo Announcement Alert Bar -->
  <div class="promo-announcement-bar py-2 text-center text-white fs-13 position-relative z-999">
    <span>Try Us Free for 30 Days – Your Wallet Can Thank Us Later!</span>
  </div>

  <!-- Hero Section -->
  <div class="hero-banner-eight bg-twelve z-1 position-relative pt-220 pb-160 xl-pb-140 md-p0 mesh-bg-1" data-aos="fade-in">
    <!-- Animated Solar Orbit Graphic -->
    <div class="hero-orbit-wrapper d-none d-lg-block position-absolute" style="top: 15%; right: 10%; width: 320px; height: 320px; opacity: 0.3; pointer-events: none; z-index: 1;">
      <svg viewBox="0 0 200 200" width="100%" height="100%">
        <defs>
          <linearGradient id="solarGradHero" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FFD700; stop-opacity:1" />
            <stop offset="50%" style="stop-color:#FF9E00; stop-opacity:1" />
            <stop offset="100%" style="stop-color:#FF007F; stop-opacity:1" />
          </linearGradient>
        </defs>
        <!-- Central Sun -->
        <circle cx="100" cy="100" r="16" fill="url(#solarGradHero)" />
        <circle cx="100" cy="100" r="24" fill="none" stroke="#FF9E00" stroke-width="1.5" stroke-dasharray="2, 4" opacity="0.6" style="transform-origin: 100px 100px; animation: spin-clockwise 20s infinite linear;" />
        
        <!-- Orbit lines -->
        <circle cx="100" cy="100" r="52" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="4, 4" />
        <circle cx="100" cy="100" r="82" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1" stroke-dasharray="8, 6" />
        
        <!-- Rotating planets -->
        <circle cx="100" cy="48" r="5" fill="#FFD700" style="transform-origin: 100px 100px; animation: spin-clockwise 15s infinite linear;" />
        <circle cx="100" cy="18" r="7" fill="#FF007F" style="transform-origin: 100px 100px; animation: spin-counter 25s infinite linear;" />
      </svg>
    </div>

    <div class="container" style="padding-top: 145px !important; position: relative; z-index: 10;">
      <div class="row align-items-center">
        <div class="col-lg-8 col-xl-8 text-start">
          <!-- Solar active instances status banner -->
          <div class="d-inline-flex align-items-center mb-3 px-3 py-1 rounded-pill" style="background: rgba(255, 158, 0, 0.08); border: 1px solid rgba(255, 158, 0, 0.15); box-shadow: 0 0 15px rgba(255, 158, 0, 0.05);">
            <span class="status-dot pulsing me-2" style="background-color: var(--accent-color); width: 8px; height: 8px; border-radius: 50%; display: inline-block; animation: pulse-glow 2s infinite ease-in-out;"></span>
            <span class="fs-12 text-white-50 uppercase tracking-widest fw-600">Active server nodes orbiting Sol-1: <span id="active-instances-ticker" class="text-accent fw-800">12,842</span></span>
          </div>
          
          <h1 class="hero-heading text-white fw-500 font-outfit" style="line-height: 1.15; font-size: clamp(2.2rem, 6vw, 3.5rem);">Bring Your Vision to Life with <span class="text-gradient">Best Hosting Company in India</span> | 1Only Host</h1>
          
          <ul class="hero-features-list style-none mt-4 mb-4 ps-0 text-white">
            <li class="d-flex align-items-center mb-2.5 fs-16 fw-600"><span class="hero-feature-dot me-3"><i class="icon icon-flash"></i></span> 99.9% Uptime Guarantee</li>
            <li class="d-flex align-items-center mb-2.5 fs-16 fw-600"><span class="hero-feature-dot me-3"><i class="icon icon-flash"></i></span> Blazing-Fast Load Times</li>
            <li class="d-flex align-items-center mb-2.5 fs-16 fw-600"><span class="hero-feature-dot me-3"><i class="icon icon-flash"></i></span> 24/7 Expert Support</li>
            <li class="d-flex align-items-center mb-2.5 fs-16 fw-600"><span class="hero-feature-dot me-3"><i class="icon icon-flash"></i></span> Effortless Control Panel</li>
            <li class="d-flex align-items-center mb-2.5 fs-16 fw-600"><span class="hero-feature-dot me-3"><i class="icon icon-flash"></i></span> Free SSL & DDoS Protection</li>
          </ul>
          
          <div class="mt-4">
            <a href="/signup" class="btn-eighteen py-3 px-5 uppercase tracking-wider fs-14 fw-600 hero-btn-pulse">Launch Your Success with a 30-Day Free Trial</a>
          </div>
          <!-- Hero Typewriter Subtext -->
          <div class="fs-14 text-white-50 mt-3 font-outfit d-flex align-items-center gap-2">
            <span class="text-accent fw-600">We power:</span>
            <span id="hero-typewriter" class="typewriter-text fw-700 text-white"></span>
            <span class="typewriter-cursor">|</span>
          </div>
        </div>
        
        <div class="col-lg-4 col-xl-4 d-none d-lg-block text-center position-relative">
          <img src={`${basePrefix}images/solar-cloud-hero.png`} alt="Bring Your Vision to Life" class="img-fluid hero-image-glow" style="max-height: 420px; filter: drop-shadow(0 10px 30px rgba(255, 158, 0, 0.15));">
        </div>
      </div>
    </div>
  </div>

  <!-- Infinite Scrolling Trust Marquee -->
  <div class="trust-marquee-strip">
    <div class="marquee-track">
      <div class="marquee-content">
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Trusted by 1000+ Businesses</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 99.9% Uptime SLA</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg> NVMe SSD Storage</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Free SSL Certificate</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> 24/7 Expert Support</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Blazing Fast Servers</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> 12+ Global Data Centers</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> DDoS Protection</span>
        <span class="marquee-divider">✦</span>
      </div>
      <div class="marquee-content" aria-hidden="true">
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Trusted by 1000+ Businesses</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 99.9% Uptime SLA</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg> NVMe SSD Storage</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Free SSL Certificate</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> 24/7 Expert Support</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Blazing Fast Servers</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF9E00" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> 12+ Global Data Centers</span>
        <span class="marquee-divider">✦</span>
        <span class="marquee-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF007F" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> DDoS Protection</span>
        <span class="marquee-divider">✦</span>
      </div>
    </div>
  </div>

  <!-- Promotions & Countdown Widget Block -->
  <div class="container lg position-relative z-3 my-4 my-lg-5">
    <div class="promo-countdown-widget">
      <div class="row align-items-center">
        <div class="col-lg-8">
          <div class="d-flex align-items-center flex-wrap gap-3">
            <span class="badge uppercase tracking-wider py-1.5 px-3 fs-10 fw-700" style="background: linear-gradient(135deg, #FF9E00, #FF007F); color: #fff; animation: tagPulse 1.5s infinite;">✨ Special Offer! 🎉</span>
            <h4 class="text-white m-0 font-outfit fw-800 fs-20">Enjoy an Exclusive 60-Day Free Trial from the Best Hosting Company in India</h4>
          </div>
          <!-- Live Countdown Timer -->
          <div class="d-flex align-items-center gap-3 mt-3.5">
            <div class="countdown-box-wrapper">
              <div class="countdown-digits" id="timer-days">00</div>
              <div class="countdown-label">Days</div>
            </div>
            <div class="fs-24 fw-800 text-white-50">:</div>
            <div class="countdown-box-wrapper">
              <div class="countdown-digits" id="timer-hours">00</div>
              <div class="countdown-label">Hours</div>
            </div>
            <div class="fs-24 fw-800 text-white-50">:</div>
            <div class="countdown-box-wrapper">
              <div class="countdown-digits" id="timer-mins">00</div>
              <div class="countdown-label">Mins</div>
            </div>
            <div class="fs-24 fw-800 text-white-50">:</div>
            <div class="countdown-box-wrapper">
              <div class="countdown-digits" id="timer-secs">00</div>
              <div class="countdown-label">Secs</div>
            </div>
          </div>
        </div>
        
        <div class="col-lg-4 mt-4 mt-lg-0 text-lg-end">
          <div class="d-inline-flex flex-column align-items-center">
            <!-- Copy Coupon -->
            <div class="coupon-box" id="coupon-container" title="Click to copy coupon code">
              <span class="text-white-50 fs-12 uppercase tracking-widest">Coupon Code</span>
              <strong id="coupon-text" class="text-accent fs-16 font-monospace">2025</strong>
              <i class="icon icon-copy text-white-50 fs-14"></i>
              <span class="coupon-toast" id="coupon-copy-toast">Copied to Clipboard!</span>
            </div>
            <a href="/signup" class="btn-eighteen uppercase tracking-wider py-2.5 px-4 fs-12 mt-3 w-100 text-center">Claim Deal now! 💥</a>
            <span class="fs-11 text-white-50 mt-2">Already trusted by 1000+ businesses</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Domain Name Availability Section -->
  <div class="domain-checker-section pb-80" data-aos="fade-up">
    <div class="container lg">
      <div class="glass-card p-5 text-center">
        <h2 class="text-white font-outfit fw-900 mb-2 fs-32">Check your domain name availability</h2>
        <p class="text-white-50 fs-16 mb-4">Register your brand name in under 60 seconds and elevate your online presence instantly!</p>
        
        <div class="d-flex justify-content-center mb-4 gap-4 flex-wrap">
          <span class="fw-700 text-accent fs-14 border-bottom border-accent pb-1" style="cursor: pointer;"><i class="icon icon-checked me-1"></i> Register</span>
          <a href="/domain-transfer" class="text-white-50 fs-14 text-decoration-none hover-accent"><i class="icon icon-chevron-right me-1"></i> Transfer domain to us</a>
        </div>
        
        <div class="home-domain max-width-800 mx-auto">
          <form id="domain-search-form" action="#" class="d-flex">
            <input type="text" id="domain-search-input" placeholder="Find your perfect domain name..." required>
            <button type="submit">Search</button>
          </form>

          <!-- Scanning Loader -->
          <div id="domain-searching-loader" class="d-none my-4 text-center">
            <div class="spinner-border text-accent mb-2" role="status" style="width: 2rem; height: 2rem; border-color: #FF9E00; border-right-color: transparent;"></div>
            <p class="text-white-50 fs-12 font-monospace m-0">// Scanning global registries across Solar coordinates...</p>
          </div>
          
          <!-- Interactive Domain Checker HUD -->
          <div id="domain-hud-results" class="glass-card p-4 mt-4 text-start d-none" style="border-color: rgba(255, 158, 0, 0.2) !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="m-0 fw-700 text-white font-outfit" style="font-size: 1.15rem;">Search Results for: <span id="searched-domain-name" class="text-accent"></span></h5>
              <button type="button" id="close-hud-btn" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded text-white border-secondary opacity-75 hover-opacity-100" style="font-size: 11px;">Close</button>
            </div>
            
            <div class="row g-3">
              <div class="col-12">
                <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background: rgba(255, 158, 0, 0.08); border: 1px solid rgba(255, 158, 0, 0.15);">
                  <div>
                    <span class="badge me-2" style="background: var(--success); color: #02040A; font-weight: 700;">AVAILABLE</span>
                    <strong id="primary-domain-result" class="fs-16 text-white font-monospace"></strong>
                  </div>
                  <div class="d-flex align-items-center">
                    <span class="fw-800 text-accent fs-18 me-3" id="primary-domain-price">₹ 1095/yr</span>
                    <a href="/signup" class="btn btn-sm btn-eighteen py-1 px-3 fs-11 uppercase tracking-wider rounded-pill" style="padding: 6px 16px !important; font-size: 11px !important;">Add to Orbit</a>
                  </div>
                </div>
              </div>
              
              <!-- Alternatives -->
              <div class="col-md-6">
                <div class="d-flex justify-content-between align-items-center p-2 px-3 rounded" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04);">
                  <span id="alt-domain-1" class="text-white-50 fs-14 font-monospace"></span>
                  <div class="d-flex align-items-center">
                    <span class="fw-700 text-white fs-14 me-3" id="alt-price-1"></span>
                    <a href="/signup" class="btn btn-sm btn-outline-light py-0 px-2 fs-10 rounded">Add</a>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex justify-content-between align-items-center p-2 px-3 rounded" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04);">
                  <span id="alt-domain-2" class="text-white-50 fs-14 font-monospace"></span>
                  <div class="d-flex align-items-center">
                    <span class="fw-700 text-white fs-14 me-3" id="alt-price-2"></span>
                    <a href="/signup" class="btn btn-sm btn-outline-light py-0 px-2 fs-10 rounded">Add</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- TLD Pricing list -->
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3 mt-4 text-white">
          <div class="col">
            <div class="p-3 rounded glass-card-sm text-center">
              <h5 class="m-0 fw-700 fs-16 text-gradient">.com</h5>
              <p class="m-0 fs-13 opacity-75 mt-1">₹ 1095</p>
            </div>
          </div>
          <div class="col">
            <div class="p-3 rounded glass-card-sm text-center border-accent-glow">
              <h5 class="m-0 fw-700 fs-16 text-accent">.in</h5>
              <p class="m-0 fs-13 opacity-75 mt-1">₹ 599</p>
            </div>
          </div>
          <div class="col">
            <div class="p-3 rounded glass-card-sm text-center">
              <h5 class="m-0 fw-700 fs-16 text-gradient">.net</h5>
              <p class="m-0 fs-13 opacity-75 mt-1">₹ 1099</p>
            </div>
          </div>
          <div class="col">
            <div class="p-3 rounded glass-card-sm text-center">
              <h5 class="m-0 fw-700 fs-16 text-gradient">.org</h5>
              <p class="m-0 fs-13 opacity-75 mt-1">₹ 999</p>
            </div>
          </div>
          <div class="col">
            <div class="p-3 rounded glass-card-sm text-center">
              <h5 class="m-0 fw-700 fs-16 text-gradient">.digital</h5>
              <p class="m-0 fs-13 opacity-75 mt-1">₹ 399</p>
            </div>
          </div>
          <div class="col">
            <div class="p-3 rounded glass-card-sm text-center">
              <h5 class="m-0 fw-700 fs-16 text-gradient">.site</h5>
              <p class="m-0 fs-13 opacity-75 mt-1">₹ 149</p>
            </div>
          </div>
        </div>
        <div class="fs-12 text-white-50 mt-4 uppercase tracking-widest"><i class="icon icon-lock me-1"></i> Secure Your Ideal Domain!</div>
      </div>
    </div>
  </div>

  <!-- Our Web Hosting Services Section -->
  <div class="services-section pb-80" data-aos="fade-up">
    <div class="container lg">
      <div class="title-eleven text-center mb-50">
        <h2 class="text-white font-outfit fw-900 fs-32">Our web hosting services</h2>
        <p class="text-white fw-500 fs-18 max-width-800 mx-auto" style="opacity: 0.95;">Explore web hosting services built for speed, security, and simplicity. From startups to enterprises, our plans from the Best Hosting Company in India deliver maximum reliability.</p>
      </div>
      
      <div class="row g-4 text-white">
        <!-- Card 1: Shared Hosting -->
        <div class="col-lg-3 col-md-6 d-flex">
          <div class="glass-card p-4 d-flex flex-column w-100 justify-content-between position-relative overflow-hidden premium-hosting-card">
            <div>
              <div class="mb-4 rounded-3 overflow-hidden" style="background: rgba(0,0,0,0.15); border: 1px solid rgba(255,255,255,0.05);">
                <img src={`${basePrefix}images/shared_hosting_thumb.png`} alt="Shared Hosting" class="img-fluid w-100" style="object-fit: cover; height: 180px; transition: transform 0.4s ease;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
              </div>
              <div class="mb-3">
                <h4 class="fw-800 m-0 font-outfit fs-20">Shared hosting</h4>
              </div>
              <p class="fs-14 opacity-75 mb-4" style="line-height: 1.6;">Ideal for blogs, portfolios, and small businesses, our shared hosting offers steady speed and robust security features. Start risk-free today with our satisfaction guarantee and enjoy peace of mind!</p>
            </div>
            <div>
              <a href="/shared-hosting" class="btn btn-sm btn-eighteen w-100 py-2 fs-12 uppercase tracking-wider rounded-pill">Learn more</a>
            </div>
          </div>
        </div>
        
        <!-- Card 2: Reseller Hosting -->
        <div class="col-lg-3 col-md-6 d-flex">
          <div class="glass-card p-4 d-flex flex-column w-100 justify-content-between position-relative overflow-hidden premium-hosting-card">
            <span class="position-absolute badge uppercase tracking-widest fs-9 py-1.5 px-3" style="top: 15px; right: 15px; background: linear-gradient(90deg, #FF9E00, #FF007F); color: #fff; font-weight: 800; border-radius: 4px; z-index: 10;">Best selling</span>
            <div>
              <div class="mb-4 rounded-3 overflow-hidden" style="background: rgba(0,0,0,0.15); border: 1px solid rgba(255,255,255,0.05);">
                <img src={`${basePrefix}images/reseller_hosting_thumb.png`} alt="Reseller Hosting" class="img-fluid w-100" style="object-fit: cover; height: 180px; transition: transform 0.4s ease;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
              </div>
              <div class="mb-3">
