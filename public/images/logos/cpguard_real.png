<script>
    var mobileMenu = false;
    var modal = document.querySelector(".cookieconsent");
    function showMenu() {

        if (mobileMenu) {
            document.getElementById('mainMenu').classList.remove('mobile-menu');
            document.getElementById('mobileMenuOpen').style.display = 'block';
            document.getElementById('mobileMenuClose').style.display = 'none';


        } else {
            document.getElementById('mainMenu').classList.add('mobile-menu');
            document.getElementById('mobileMenuOpen').style.display = 'none';
            document.getElementById('mobileMenuClose').style.display = 'block';
        }
        mobileMenu = !mobileMenu;
        console.log(document.getElementById('mainMenu').style.display);
    }

    function toggleModal() {
        setCookie("CookieAccepted", true, Date.now() + 604800, "/");
        modal.classList.toggle("show");
    }

    document.addEventListener('DOMContentLoaded', function () {
        setTimeout(() => {
            if (!getCookie('CookieAccepted')) {
                toggleModal();
            }
        }, 1000);
    });
</script>

</body>
</html>