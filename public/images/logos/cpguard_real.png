<script>
    function manualUpdate() {
        handleScrollDebug();
    }

    function handleScrollDebug() {
        var currentScrollPos = window.pageYOffset || window.scrollY || 0;
        var notificationBar = document.getElementById("siteNotificationBar");
        var threshold = 100;

        var thresholdElement = document.getElementById("thresholdValue");
        var scrollElement = document.getElementById("currentScrollValue");
        var statusElement = document.getElementById("bannerStatus");

        if (thresholdElement) {
            thresholdElement.textContent = threshold;
        }
        if (scrollElement) {
            scrollElement.textContent = Math.round(currentScrollPos);
        }

        if (!notificationBar) return;

        if (currentScrollPos <= threshold) {
            notificationBar.className = "site-announcement active";
            notificationBar.style.display = "flex";
            notificationBar.style.visibility = "visible";
            notificationBar.style.opacity = "1";
            notificationBar.style.height = "65px";
            if (statusElement) statusElement.textContent = "visible";
        } else {
            notificationBar.className = "site-announcement expired";
            notificationBar.style.display = "";
            notificationBar.style.visibility = "";
            notificationBar.style.opacity = "";
            notificationBar.style.height = "";
            if (statusElement) statusElement.textContent = "hidden";
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var banner = document.getElementById("siteNotificationBar");
        if (banner) {
            banner.className = "site-announcement active";
        }

        setTimeout(function () {
            handleScrollDebug();
        }, 100);

        window.addEventListener('scroll', function () {
            handleScrollDebug();
        });

        var throttleTimer = null;
        window.addEventListener('scroll', function () {
            if (throttleTimer) clearTimeout(throttleTimer);
            throttleTimer = setTimeout(function () {
                handleScrollDebug();
            }, 16);
        });
    });
</script>
